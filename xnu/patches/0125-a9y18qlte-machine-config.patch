diff --git a/pexpert/pexpert/arm64/A9Y18QLTE.h b/pexpert/pexpert/arm64/A9Y18QLTE.h
new file mode 100644
index 0000000..8be1857
--- /dev/null
+++ b/pexpert/pexpert/arm64/A9Y18QLTE.h
@@ -0,0 +1,18 @@
+/*
+ * Board config for the Samsung Galaxy A9 2018 ("a9y18qlte", Qualcomm SDM660):
+ * Kryo 260 = Cortex-A73 + Cortex-A53, ARMv8.0: no LSE, no PAN, no PAC, and
+ * no 16K translation granule (ID_AA64MMFR0_EL1 reads 0x1122), so 4K pages.
+ *
+ * The rest is the generic Qualcomm board code from ios-sweet/ios-flame
+ * (GICv3 with TrustZone owning Group 0, PSCI, Qualcomm timer PPIs), which
+ * keys off SWEET: SWEET.h holds it, with the ARMv8.2 parts left out here.
+ */
+
+#ifndef _PEXPERT_ARM64_A9Y18QLTE_H
+#define _PEXPERT_ARM64_A9Y18QLTE_H
+
+#define A9Y18QLTE                 1
+
+#include <pexpert/arm64/SWEET.h>
+
+#endif /* ! _PEXPERT_ARM64_A9Y18QLTE_H */
