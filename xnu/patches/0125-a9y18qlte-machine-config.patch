+/*
+ * Tear-free present: the panel is a video-mode one (INTF1's timing engine on, scanning at 60 Hz), and a frame drawn into
+ * the buffer it scans shows the line between old and new (fades and icon presses sweeping top to bottom). Frames are drawn
+ * into one of three buffers in ABL's splash carve-out and shown by moving VIG0's address, which a CTL flush applies at
+ * the next vsync. Boot-arg sweetfb_flip=0 draws into the scanned buffer as before.
+ */
+static int panel_flip = -1;     /* -1 until the boot-arg is read (sweet_gpu_panel_stride) */
+static int panel_shown;         /* the buffer VIG0 points at */
+static int panel_last = -1;     /* drawn last, not on screen yet */
+static uint32_t panel_last_fence;
+
+static void
+panel_show_locked(int b)
+{
+	a6_wr(SSPP_VIG(0) + SSPP_SRC0_ADDR, (uint32_t)(A6_FB_PA + A6_FB_BUF * (uint64_t)b));
+	a6_wr(CTL0_FLUSH, 0x1);
+	panel_shown = b;
+}
+
+/* SweetFramebuffer's CPU copy writes the first buffer: put it back on screen before one. */
+void
+sweet_gpu_panel_home(void)
+{
+	lck_mtx_lock(&sweet_gpu_lock);
+	if (panel_shown != 0) {
+		panel_show_locked(0);
+	}
+	panel_last = -1;
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
+int
+sweet_gpu_panel_shown(void)
+{
+	return panel_shown;
+}
+
+/* SweetFramebuffer's display-off blank: a buffer it cleared goes on screen at the next vsync. */
+void
+sweet_gpu_panel_show(int b)
+{
+	if (b < 0 || b > 2) {
+		return;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	panel_show_locked(b);
+	panel_last = -1;
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
