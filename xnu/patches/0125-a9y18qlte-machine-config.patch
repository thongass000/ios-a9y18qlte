diff --git a/bsd/dev/a9y_gpu.c b/bsd/dev/a9y_gpu.c
new file mode 100644
index 0000000..aca3760
--- /dev/null
+++ b/bsd/dev/a9y_gpu.c
@@ -0,0 +1,655 @@
+/*
+ * a9y18qlte (Galaxy A9 2018, SDM660) Adreno 512 (kgsl-3d0@5000000, chip id
+ * 0x05010200): bring-up, first worked out in the probe shim (a9-ios shim.c
+ * gpu_probe, tools/a9y/shim in the fork):
+ *   - GCC GPU AHB/BIMC branches, GPUCC CXO/rbbmtimer/gfx3d (XO), CX GDSC,
+ *     then the GX block reset, GMEM reset pulse, clamp off and GX GDSC.
+ *   - The GPU SMMU (arm,smmu-kgsl@5040000, qsmmuv2, qcom,skip-init) sits
+ *     behind the hypervisor: it refuses bypass, a mask spanning streams 0
+ *     and 2, and never completes a TLB sync for us. So, as Linux leaves it:
+ *     micro MMU halt + attach-impl-defs + resume, sCR0 fault reporting,
+ *     exact SMRs (stream 0 -> CB0, stream 2 -> CB1, the CP's fetches while
+ *     it is still secure), stage-1 context banks over an identity map of
+ *     the carve-out's GiB (TCR2.SEP upstream, or bit 31 picks TTBR1), and
+ *     no TLB syncs at all (the TLBs are empty at boot).
+ *   - a530 PM4/PFP microcode and kgsl's a5xx_start() values for the a512
+ *     (without the fetch queue thresholds the CP never reads the ring).
+ *   - The GPU comes up secure (RBBM_SECVID_TRUST_CNTL 1; a non-secure write
+ *     to it stalls the bus): ME_INIT runs secure, TZ loads the a512_zap
+ *     shader (SCM PAS 13), then CP_SET_SECURE_MODE(0) from the ring.
+ * The firmware is not in the kernel: the shim leaves its blob ("A9YGPUFW",
+ * shim build.sh) in RAM below XNU's and passes it as a9ygpufw=<pa>. The
+ * GPU's own memory is a carve-out in that RAM too (the dead Linux image),
+ * mapped uncached. A self test follows: a CP_MEM_WRITE, and a 2D-engine
+ * rectangle (on the a512 only BLIT_OP_SCALE writes, and its source reads
+ * as 0: tools/a9y/gpu/kgsltest).
+ */
+#if defined(ARM64_BOARD_CONFIG_A9Y18QLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void IOSleep(unsigned int milliseconds);
+void a9y_gpu_init(void);
+
+#define GCC_GPU_PA              0x00171000u     /* + 0x004 cfg AHB, 0x010 GPU BIMC, 0x06c BIMC GFX */
+#define GPUCC_PA                0x05065000u
+#define GPU_PA                  0x05000000u
+#define SMMU_PA                 0x05040000u
+
+/* the carve-out: below XNU's RAM (0x100000000), in the Linux image the shim did not boot */
+#define CARVE_PA                0x82000000u
+#define CARVE_SIZE              0x00050000u      /* mapped in small pieces: ml_io_map has little room */
+#define C_PT                    0x000000u       /* SMMU level 1 table */
+#define C_RING                  0x001000u       /* 32 KiB */
+#define C_PM4                   0x010000u
+#define C_PFP                   0x018000u
+#define C_SCRATCH               0x020000u
+#define C_ZAP                   0x100000u       /* 1 MiB aligned (the segment's p_align), mapped apart */
+#define C_SURF                  0x030000u       /* self test surfaces, 64 KiB each */
+#define RING_DWORDS             8192
+
+#define GPUCC_CXO_CBCR          0x1020
+#define GPUCC_GFX3D_RCGR        0x1070
+#define GPUCC_GFX3D_CBCR        0x1098
+#define GPUCC_RBBMTIMER_RCGR    0x10b0
+#define GPUCC_RBBMTIMER_CBCR    0x10d0
+#define GPUCC_GX_DOMAIN_MISC    0x0130
+#define GPUCC_CX_GDSC           0x1004
+#define GPUCC_GX_BCR            0x1090
+#define GPUCC_GX_GDSC           0x1094
+
+#define CP_ME_INIT              0x48
+#define CP_MEM_WRITE            0x3d
+#define CP_SET_SECURE_MODE      0x66
+#define CP_WAIT_FOR_IDLE        0x26
+#define CP_EVENT_WRITE          0x46
+#define CP_SET_RENDER_MODE      0x6c
+#define CP_BLIT                 0x2c
+
+#define GPU_MAGIC               0xa9c0ffeeu
+#define GPU_BLIT_DONE           0xb117d0e5u
+
+static vm_offset_t gcc, gpucc, gpu, smmu, carve, zap;
+static uint64_t gpufw_pa;
+static vm_offset_t gpufw;
+static uint32_t ring_w;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+#define GR(r)                   (gpu + (vm_offset_t)(r) * 4)
+#define C(off)                  (carve + (off))
+#define CPA(off)                ((uint64_t)CARVE_PA + (off))
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t end = mach_absolute_time() + (uint64_t)us * 192 / 10;      /* 19.2 MHz timebase */
+	while (mach_absolute_time() < end) {
+		;
+	}
+}
+
+static int
+branch_on(vm_offset_t cbcr)
+{
+	wr(cbcr, rd(cbcr) | 1);
+	for (int i = 0; i < 1000; i++) {
+		if (!(rd(cbcr) >> 31)) {        /* CLK_OFF clear */
+			return 0;
+		}
+		spin_us(1);
+	}
+	return -1;
+}
+
+/* RCG to XO, divider 1, latched with UPDATE; root forced on if asked */
+static int
+rcg_xo(vm_offset_t rcgr, int force_root)
+{
+	wr(rcgr + 4, 0);
+	wr(rcgr, rd(rcgr) | 1 | (force_root ? 2 : 0));
+	for (int i = 0; i < 1000; i++) {
+		if (!(rd(rcgr) & 1)) {
+			return 0;
+		}
+		spin_us(1);
+	}
+	return -1;
+}
+
+static int
+gdsc_on(vm_offset_t gdscr)
+{
+	wr(gdscr, rd(gdscr) & ~1u);
+	for (int i = 0; i < 2000; i++) {
+		if (rd(gdscr) >> 31) {          /* PWR_ON */
+			return 0;
+		}
+		spin_us(1);
+	}
+	return -1;
+}
+
+static int
+gpu_power(void)
+{
+	int rc = branch_on(gcc + 0x004) | branch_on(gcc + 0x010) | branch_on(gcc + 0x06c);
+	rc |= branch_on(gpucc + GPUCC_CXO_CBCR) << 1;
+	rc |= rcg_xo(gpucc + GPUCC_RBBMTIMER_RCGR, 0) << 2;
+	rc |= branch_on(gpucc + GPUCC_RBBMTIMER_CBCR) << 3;
+	rc |= rcg_xo(gpucc + GPUCC_GFX3D_RCGR, 1) << 4;
+	rc |= gdsc_on(gpucc + GPUCC_CX_GDSC) << 5;
+	return rc;
+}
+
+/* GX: block reset pulse, GMEM reset pulse, clamp off, power, core clock */
+static int
+gpu_power_gx(void)
+{
+	wr(gpucc + GPUCC_GX_BCR, rd(gpucc + GPUCC_GX_BCR) | 1);
+	spin_us(1);
+	wr(gpucc + GPUCC_GX_BCR, rd(gpucc + GPUCC_GX_BCR) & ~1u);
+	wr(gpucc + GPUCC_GX_DOMAIN_MISC, rd(gpucc + GPUCC_GX_DOMAIN_MISC) | (1u << 4));
+	spin_us(1);
+	wr(gpucc + GPUCC_GX_DOMAIN_MISC, rd(gpucc + GPUCC_GX_DOMAIN_MISC) & ~(1u << 4));
+	wr(gpucc + GPUCC_GX_DOMAIN_MISC, rd(gpucc + GPUCC_GX_DOMAIN_MISC) & ~1u);
+	int rc = gdsc_on(gpucc + GPUCC_GX_GDSC);
+	rc |= branch_on(gpucc + GPUCC_GFX3D_CBCR) << 1;
+	return rc;
+}
+
+/*
+ * ---- GPU SMMU ----
+ * DT attach-impl-defs, written with the micro MMU halted; then streams 0
+ * and 2 to context banks 0 and 1, both over one identity-mapped GiB.
+ */
+static const uint32_t smmu_impl[][2] = {
+	{ 0x6000, 0x2378 }, { 0x6060, 0x1055 }, { 0x678c, 0x08 }, { 0x6794, 0x28 },
+	{ 0x6800, 0x06 }, { 0x6900, 0x3ff }, { 0x6924, 0x204 }, { 0x6928, 0x11000 },
+	{ 0x6930, 0x800 }, { 0x6960, 0xffffffff }, { 0x6b64, 0x1a5551 }, { 0x6b68, 0x9a82a382 },
+};
+static const uint32_t smmu_sid[2] = { 0, 2 };
+
+#define SMMU_GR1                (smmu + 0x1000)
+#define SMMU_CB(n)              (smmu + 0x8000 + (n) * 0x1000)
+
+static int
+gpu_smmu(void)
+{
+	uint32_t cr0 = rd(smmu), idr0 = rd(smmu + 0x20);
+	if ((cr0 & 1) || !((cr0 >> 10) & 1) || (idr0 & 0xff) < 2 || (rd(smmu + 0x800) >> 31)) {
+		printf("A9Y GPU: smmu not as at boot (cr0 %x idr0 %x smr0 %x)\n", cr0, idr0,
+		    rd(smmu + 0x800));
+		return -1;
+	}
+	wr(smmu + 0x6000, rd(smmu + 0x6000) | (1u << 2));            /* LOCAL_HALT_REQ */
+	for (int i = 0; i < 1000 && !(rd(smmu + 0x6000) & (1u << 3)); i++) {    /* IDLE */
+		spin_us(1);
+	}
+	for (unsigned k = 0; k < sizeof(smmu_impl) / sizeof(smmu_impl[0]); k++) {
+		wr(smmu + smmu_impl[k][0], smmu_impl[k][1]);
+	}
+	wr(smmu + 0x6000, rd(smmu + 0x6000) & ~(1u << 2));
+	wr(smmu + 0x48, rd(smmu + 0x48));       /* sGFSR clear */
+	wr(smmu + 0x68, 0xffffffff);            /* TLBIALLNSNH; no sTLBGSYNC: it never completes */
+	wr(smmu + 0x6c, 0xffffffff);            /* TLBIALLH */
+	cr0 |= 1u << 1 | 1u << 2 | 1u << 4 | 1u << 5;    /* GFRE GFIE GCFGFRE GCFGFIE */
+	cr0 |= 1u << 11 | 1u << 12;                      /* VMIDPNE PTM */
+	cr0 &= ~(1u | 1u << 13 | 3u << 14);              /* CLIENTPD FB BSU */
+	cr0 |= 3u << 22;                                 /* SHCFG NSH */
+	wr(smmu, cr0);
+
+	/* level 1, 4K granule, 32-bit input: the carve-out's GiB (and the framebuffer's) */
+	volatile uint64_t *pt = (volatile uint64_t *)C(C_PT);
+	for (int i = 0; i < 512; i++) {
+		pt[i] = 0;
+	}
+	uint64_t gib = CARVE_PA >> 30;
+	pt[gib] = gib << 30 | 1 | 1u << 6 | 1u << 10;   /* block, AttrIndx 0, AP RW, AF */
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	int rc = 0;
+	for (uint32_t n = 0; n < 2; n++) {
+		vm_offset_t cb = SMMU_CB(n);
+		wr(cb, 0);
+		wr(SMMU_GR1 + 0x800 + 4 * n, 1);                /* CBA2R: VA64 */
+		/* CBAR: S1 + S2 bypass, NSH, WB, VMID cb + 1 as Linux's arm-smmu */
+		wr(SMMU_GR1 + 4 * n, 1u << 16 | 3u << 8 | 0xfu << 12 | (n + 1));
+		wr(cb + 0x20, (uint32_t)CPA(C_PT));             /* TTBR0, ASID 0 */
+		wr(cb + 0x24, 0);
+		wr(cb + 0x10, 2 | 7u << 15);                    /* TCR2: 40-bit PA, SEP upstream */
+		wr(cb + 0x30, 32 | 1u << 23);                   /* TCR: T0SZ 32, 4K, no TTBR1 */
+		wr(cb + 0x38, 0x44);                            /* MAIR0: normal non-cacheable */
+		wr(cb + 4, 0x70000000);                         /* ACTLR: Qualcomm ISH/OSH/NSH */
+		wr(cb + 0x58, 0xffffffff);                      /* FSR clear */
+		wr(cb + 0x618, 0);                              /* TLBIALL; no TLBSYNC */
+		wr(cb, 1 | 1u << 1 | 1u << 2 | 1u << 5);        /* SCTLR: M, TRE, AFE, CFRE */
+		/* SMR before S2CR, as Linux's arm-smmu; exact stream ids */
+		wr(smmu + 0x800 + 4 * n, 1u << 31 | smmu_sid[n]);
+		__asm__ volatile ("dsb sy; isb" ::: "memory");
+		wr(smmu + 0xc00 + 4 * n, 3u << 8 | n);          /* translate, SHCFG NSH */
+		__asm__ volatile ("dsb sy; isb" ::: "memory");
+		if (!(rd(smmu + 0x800 + 4 * n) >> 31) || (rd(smmu + 0xc00 + 4 * n) & 0x300ff) != n) {
+			rc = -2;
+		}
+	}
+	printf("A9Y GPU: smmu cr0 %x, stream 0 -> cb0 (smr %x s2cr %x), stream 2 -> cb1 (smr %x s2cr %x)\n",
+	    rd(smmu), rd(smmu + 0x800), rd(smmu + 0xc00), rd(smmu + 0x804), rd(smmu + 0xc04));
+	return rc;
+}
+
+/* ---- firmware from the shim's blob ---- */
+static int
+streq_fw(vm_offset_t a, const char *b)
+{
+	for (int i = 0; i < 16; i++) {
+		char c = *(volatile char *)(a + i);
+		if (c != b[i]) {
+			return 0;
+		}
+		if (!c) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* file NAME in the blob: its offset from the blob's start, *size; 0 if missing */
+static uint32_t
+gpufw_find(const char *name, uint32_t *size)
+{
+	uint32_t n = rd(gpufw + 8);
+	for (uint32_t i = 0; i < n && i < 16; i++) {
+		vm_offset_t e = gpufw + 12 + 24 * i;
+		if (streq_fw(e, name)) {
+			*size = rd(e + 20);
+			return rd(e + 16);
+		}
+	}
+	return 0;
+}
+
+/* microcode NAME without its first dword into the carve-out at OFF */
+static int
+gpufw_copy(const char *name, uint32_t off, uint32_t max)
+{
+	uint32_t size = 0, at = gpufw_find(name, &size);
+	if (!at || size < 8 || size - 4 > max) {
+		return -1;
+	}
+	for (uint32_t w = 0; w < (size - 4) / 4; w++) {
+		wr(C(off) + 4 * w, rd(gpufw + at + 4 + 4 * w));
+	}
+	return (int)(size - 4);
+}
+
+/*
+ * ---- TZ peripheral authentication for the zap shader ----
+ * SCM service 2, ARMv8 SMC convention (Linux qcom_scm-smc.c): x0 = SMC64
+ * SIP | svc << 8 | cmd, x1 = arginfo, x2.. = args, x6 = 0; busy (-12) is retried,
+ * interrupted (1, an IRQ came in: XNU runs with them on) resumed as Linux's scm.c
+ * does, by calling again with the registers TZ returned.
+ */
+#define PAS_INIT_IMAGE          1
+#define PAS_MEM_SETUP           2
+#define PAS_AUTH_AND_RESET      5
+#define GPU_PAS_ID              13
+
+static long
+scm_pas(uint32_t cmd, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c)
+{
+	register uint64_t x0 __asm__("x0");
+	for (int tries = 0; tries < 100; tries++) {
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a;
+		register uint64_t x3 __asm__("x3") = b;
+		register uint64_t x4 __asm__("x4") = c;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = 0;
+		x0 = 0x42000000ul | 2 << 8 | cmd;
+		do {
+			__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4),
+                                 "+r"(x5), "+r"(x6) : : "x7", "x8", "x9", "x10", "x11", "x12",
+                                 "x13", "x14", "x15", "x16", "x17", "memory");
+		} while (x0 == 1);
+		if ((long)x0 != -12) {
+			break;
+		}
+		spin_us(100);
+	}
+	return (long)x0;
+}
+
+/* metadata = the whole .mdt (headers + hash), one relocatable segment (.b02) */
+static int
+gpu_zap(void)
+{
+	uint32_t mdt_size = 0, seg_size = 0;
+	uint32_t mdt = gpufw_find("a512_zap.mdt", &mdt_size), seg = gpufw_find("a512_zap.b02", &seg_size);
+	uint32_t region = (seg_size + 0xfff) & ~0xfffu;
+	if (!mdt || !seg) {
+		return -1;
+	}
+	long rc1 = scm_pas(PAS_INIT_IMAGE, 2 | 2 << 6, GPU_PAS_ID, gpufw_pa + mdt, 0);
+	long rc2 = rc1 ? -1 : scm_pas(PAS_MEM_SETUP, 3, GPU_PAS_ID, CPA(C_ZAP), region);
+	if (!rc1 && !rc2) {
+		for (uint32_t w = 0; w < region / 4; w++) {
+			wr(zap + 4 * w, 4 * w < seg_size ? rd(gpufw + seg + 4 * w) : 0);
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	long rc3 = rc1 || rc2 ? -1 : scm_pas(PAS_AUTH_AND_RESET, 1, GPU_PAS_ID, 0, 0);
+	printf("A9Y GPU: zap pas init %ld mem setup %ld auth %ld\n", rc1, rc2, rc3);
+	return rc1 || rc2 || rc3 ? -2 : 0;
+}
+
+/* ---- PM4 packets ---- */
+static uint32_t
+pm4_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^
+	       (v >> 24) ^ (v >> 28)))) & 1;
+}
+
+static uint32_t
+pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000u | cnt | pm4_parity(cnt) << 15 | op << 16 | pm4_parity(op) << 23;
+}
+
+static uint32_t
+pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000u | cnt | pm4_parity(cnt) << 7 | reg << 8 | pm4_parity(reg) << 27;
+}
+
+static void
+ring(uint32_t v)
+{
+	wr(C(C_RING) + 4 * ring_w, v);
+	ring_w++;
+}
+
+/* hand the ring to the CP up to here; wait for RPTR to catch up */
+static int
+ring_kick(uint32_t ms)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(GR(0x807), ring_w);                  /* CP_RB_WPTR */
+	for (uint32_t i = 0; i < ms * 2; i++) {
+		if (rd(GR(0x806)) == ring_w) {  /* CP_RB_RPTR */
+			return 0;
+		}
+		spin_us(500);
+	}
+	return -1;
+}
+
+static int
+wait_word(vm_offset_t a, uint32_t v, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 2; i++) {
+		if (rd(a) == v) {
+			return 0;
+		}
+		spin_us(500);
+	}
+	return -1;
+}
+
+/*
+ * ---- self test: the 2D engine ----
+ * freedreno fd5_blitter.c's emit_setup + sysmem prep around one RGBA8
+ * rectangle; ends with CCU flush and CACHE_FLUSH_TS writing DONE.
+ */
+static void
+gpu_rect(uint64_t src, uint64_t dst, uint32_t width, uint32_t height, uint32_t pitch, uint64_t done)
+{
+	ring(pkt7(CP_SET_RENDER_MODE, 5));
+	ring(1);                                /* BYPASS */
+	for (int k = 0; k < 4; k++) {
+		ring(0);
+	}
+	ring(pkt4(0xe91, 5));                   /* UCHE_CACHE_INVALIDATE_MIN/MAX, INVALIDATE */
+	for (int k = 0; k < 4; k++) {
+		ring(0);
+	}
+	ring(0x12);
+	ring(pkt7(CP_WAIT_FOR_IDLE, 0));
+	ring(pkt7(0x1d, 1));                    /* CP_SKIP_IB2_ENABLE_GLOBAL */
+	ring(0);
+	ring(pkt7(CP_EVENT_WRITE, 1));
+	ring(0x19);                             /* PC_CCU_INVALIDATE_COLOR */
+	ring(pkt4(0xe3b0, 1));                  /* PC_POWER_CNTL: 2 SP cores */
+	ring(1);
+	ring(pkt4(0xe4f0, 1));                  /* VFD_POWER_CNTL */
+	ring(1);
+	ring(pkt7(CP_WAIT_FOR_IDLE, 0));
+	ring(pkt4(0x0cc7, 1));                  /* RB_CCU_CNTL: BYPASS */
+	ring(0x10000000);
+	static const uint16_t setup[][2] = {
+		{ 0xe141, 0x8 },                /* RB_RENDER_CNTL */
+		{ 0x0cc6, 0x4 },                /* RB_MODE_CNTL */
+		{ 0x0ec2, 0xc },                /* SP_MODE_CNTL */
+		{ 0x0f02, 0x344 },              /* TPL1_MODE_CNTL */
+		{ 0x0e06, 0x2 },                /* HLSQ_MODE_CNTL */
+		{ 0xe000, 0x181 },              /* GRAS_CL_CNTL */
+		{ 0x2184, 0x9 },                /* UNKNOWN_2184 */
+		{ 0xe140, 1u << 17 },           /* RB_CNTL: BYPASS */
+	};
+	for (unsigned k = 0; k < sizeof(setup) / sizeof(setup[0]); k++) {
+		ring(pkt4(setup[k][0], 1));
+		ring(setup[k][1]);
+	}
+	ring(pkt4(0x2100, 1));                  /* RB_2D_BLIT_CNTL */
+	ring(0x86000000);
+	ring(pkt4(0x2180, 1));                  /* GRAS_2D_BLIT_CNTL */
+	ring(0x86000000);
+	/* RB5_R8G8B8A8_UNORM, linear; pitch and array pitch in 64-byte units */
+	uint32_t info = 0x30, size = pitch >> 6 | ((pitch * height) >> 6) << 16;
+	ring(pkt7(CP_SET_RENDER_MODE, 1));
+	ring(7);                                /* BLIT2DSCALE */
+	for (int s = 0; s < 2; s++) {
+		uint64_t a = s ? dst : src;
+		ring(pkt4(s ? 0x2110 : 0x2107, 9));     /* RB_2D_SRC/DST_INFO, address, size, 5 unknown */
+		ring(info);
+		ring((uint32_t)a);
+		ring((uint32_t)(a >> 32));
+		ring(size);
+		for (int k = 0; k < 5; k++) {
+			ring(0);
+		}
+		ring(pkt4(s ? 0x2182 : 0x2181, 1));     /* GRAS_2D_SRC/DST_INFO */
+		ring(info);
+	}
+	ring(pkt7(CP_BLIT, 5));
+	ring(3);                                /* BLIT_OP_SCALE: the one op that writes */
+	ring(0);
+	ring((width - 1) | (height - 1) << 16);
+	ring(0);
+	ring((width - 1) | (height - 1) << 16);
+	ring(pkt7(CP_SET_RENDER_MODE, 1));
+	ring(8);                                /* END2D */
+	ring(pkt7(CP_WAIT_FOR_IDLE, 0));
+	ring(pkt7(CP_EVENT_WRITE, 4));
+	ring(0x1d);                             /* PC_CCU_FLUSH_COLOR_TS */
+	ring((uint32_t)(done + 8));
+	ring((uint32_t)((done + 8) >> 32));
+	ring(0);
+	ring(pkt7(CP_EVENT_WRITE, 4));
+	ring(0x04);                             /* CACHE_FLUSH_TS */
+	ring((uint32_t)done);
+	ring((uint32_t)(done >> 32));
+	ring(GPU_BLIT_DONE);
+}
+
+static int
+gpu_start(void)
+{
+	int npm4 = gpufw_copy("a530_pm4.fw", C_PM4, 0x8000);
+	int npfp = gpufw_copy("a530_pfp.fw", C_PFP, 0x8000);
+	if (npm4 <= 0 || npfp <= 0) {
+		printf("A9Y GPU: no microcode in the blob (pm4 %d pfp %d)\n", npm4, npfp);
+		return -1;
+	}
+	static const uint32_t regs[][2] = {
+		{ 0x860, 1 },                   /* CP_ADDR_MODE_CNTL: 64 bit */
+		/* VSC GRAS RB PC HLSQ VFD VPC UCHE SP TPL1 _ADDR_MODE_CNTL: 64 bit too, as kgsl's a5xx_start() */
+		{ 0xbc1, 1 }, { 0xc81, 1 }, { 0xcc5, 1 }, { 0xd01, 1 }, { 0xe05, 1 },
+		{ 0xe41, 1 }, { 0xe61, 1 }, { 0xe80, 1 }, { 0xec1, 1 }, { 0xf01, 1 },
+		{ 0x838, (uint32_t)(CARVE_PA + C_PM4) }, { 0x839, 0 },   /* CP_PM4_INSTR_BASE */
+		{ 0x835, (uint32_t)(CARVE_PA + C_PFP) }, { 0x836, 0 },   /* CP_PFP_INSTR_BASE */
+		{ 0x800, (uint32_t)(CARVE_PA + C_RING) }, { 0x801, 0 },  /* CP_RB_BASE */
+		{ 0x802, 12 | 2u << 8 | 1u << 27 },     /* CP_RB_CNTL: 32 KiB, no rptr update */
+		{ 0x807, 0 },                   /* CP_RB_WPTR */
+		{ 0xf810, 1 },                  /* SECVID_TSB_ADDR_MODE_CNTL: 64 bit */
+		{ 0xf800, 0 }, { 0xf801, 0 }, { 0xf802, 0 },     /* no trusted TSB range */
+		/* kgsl a5xx_start() for the a512 */
+		{ 0x3049, 0x3 },                /* VBIF_ROUND_ROBIN_QOS_ARB */
+		{ 0x302a, 0x9 },                /* VBIF_GATE_OFF_WRREQ_EN */
+		{ 0x93, 0x1 },                  /* RBBM_AHB_CNTL0 */
+		{ 0x94, 0xa6ffffff },           /* RBBM_AHB_CNTL1 */
+		{ 0x95, 0x3f },                 /* RBBM_AHB_CNTL2 */
+		{ 0xe96, 0x2 },                 /* UCHE_CACHE_WAYS */
+		{ 0xe89, 0xffff0000 }, { 0xe8a, 0x0001ffff },    /* UCHE_TRAP_BASE */
+		{ 0xe87, 0xffff0000 }, { 0xe88, 0x0001ffff },    /* UCHE_WRITE_THRU_BASE */
+		{ 0xe8b, 0x100000 }, { 0xe8c, 0 },               /* UCHE_GMEM_RANGE: 272 KiB GMEM */
+		{ 0xe8d, 0x100000 + 0x44000 - 1 }, { 0xe8e, 0 },
+		{ 0xe81, 1u << 29 },            /* UCHE_MODE_CNTL */
+		{ 0x825, 0x40 },                /* CP_MEQ_THRESHOLDS */
+		{ 0x826, 0x400 },               /* CP_MERCIU_SIZE */
+		{ 0x820, 0x80000060 },          /* CP_ROQ_THRESHOLDS_2 */
+		{ 0x81f, 0x40201b16 },          /* CP_ROQ_THRESHOLDS_1 */
+		{ 0x833, 0x02000000 },          /* CP_CHICKEN_DBG */
+		{ 0x67, 0 },                    /* RBBM_CLOCK_CNTL: hw clock gating off */
+	};
+	for (unsigned k = 0; k < sizeof(regs) / sizeof(regs[0]); k++) {
+		wr(GR(regs[k][0]), regs[k][1]);
+	}
+
+	ring_w = 0;
+	ring(pkt7(CP_ME_INIT, 8));
+	ring(0x0000002f);
+	ring(0x00000003);                       /* multiple hardware contexts */
+	ring(0x20000000);                       /* error detection */
+	for (int k = 0; k < 5; k++) {
+		ring(0);
+	}
+	wr(GR(0x832), 0);                       /* CP_ME_CNTL: run ME and PFP */
+	int me = ring_kick(100);
+	printf("A9Y GPU: microcode pm4 %d pfp %d, ME_INIT %s (rptr %u, rbbm status %x), trust cntl %x\n",
+	    npm4, npfp, me ? "STUCK" : "done", rd(GR(0x806)), rd(GR(0x4f5)), rd(GR(0xf400)));
+	if (me) {
+		return -2;
+	}
+	if (gpu_zap() == 0) {
+		ring(pkt7(CP_SET_SECURE_MODE, 1));
+		ring(0);
+	}
+	vm_offset_t scratch = C(C_SCRATCH);
+	wr(scratch, 0);
+	ring(pkt7(CP_MEM_WRITE, 3));
+	ring((uint32_t)CPA(C_SCRATCH));
+	ring(0);
+	ring(GPU_MAGIC);
+	ring_kick(100);
+	int ok = wait_word(scratch, GPU_MAGIC, 100) == 0;
+	printf("A9Y GPU: CP_MEM_WRITE %s (scratch %x, rptr %u), trust cntl %x\n",
+	    ok ? "ran" : "FAILED", rd(scratch), rd(GR(0x806)), rd(GR(0xf400)));
+	return ok ? 0 : -3;
+}
+
+/* the 2D engine fills a magenta 256x256 RGBA8 surface: expect black everywhere */
+static void
+gpu_selftest(void)
+{
+	const uint32_t w = 128, h = 128, pitch = w * 4, n = w * h;
+	vm_offset_t dst = C(C_SURF + 0x10000), done = C(C_SCRATCH + 0x40);
+	for (uint32_t k = 0; k < n; k++) {
+		wr(dst + 4 * k, 0xffff00ff);
+	}
+	wr(done, 0);
+	gpu_rect(CPA(C_SURF), CPA(C_SURF + 0x10000), w, h, pitch, CPA(C_SCRATCH + 0x40));
+	ring_kick(500);
+	int ok = wait_word(done, GPU_BLIT_DONE, 500) == 0;
+	uint32_t black = 0, untouched = 0;
+	for (uint32_t k = 0; k < n; k++) {
+		uint32_t d = rd(dst + 4 * k);
+		black += d == 0;
+		untouched += d == 0xffff00ff;
+	}
+	printf("A9Y GPU: 2D rect %ux%u %s: %u of %u pixels written black, %u untouched; "
+	    "smmu gfsr %x cb0 fsr %x\n", w, h, ok ? "done" : "NOT DONE", black, n, untouched,
+	    rd(smmu + 0x48), rd(SMMU_CB(0) + 0x58));
+}
+
+static void
+gpu_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	gcc = ml_io_map(GCC_GPU_PA, 0x1000);
+	gpucc = ml_io_map(GPUCC_PA, 0x2000);
+	gpu = ml_io_map(GPU_PA, 0x40000);
+	smmu = ml_io_map(SMMU_PA, 0x10000);
+	carve = ml_io_map(CARVE_PA, CARVE_SIZE);
+	zap = ml_io_map(CARVE_PA + C_ZAP, 0x2000);
+	gpufw = ml_io_map((vm_offset_t)(gpufw_pa & ~0xfffull), 0x20000) + (gpufw_pa & 0xfff);
+	if (rd(gpufw) != 0x47593941 || rd(gpufw + 4) != 0x57465550) {          /* "A9YG" "PUFW" */
+		printf("A9Y GPU: no firmware blob at a9ygpufw=%llx\n", gpufw_pa);
+		return;
+	}
+
+	/*
+	 * The rbbmtimer branch never reports on (in the shim either), harmless:
+	 * go on once the CX GDSC is powered.
+	 */
+	int rc = gpu_power();
+	int cx = rd(gpucc + GPUCC_CX_GDSC) >> 31;
+	int smmu_rc = cx ? gpu_smmu() : -1;     /* with only CX up, as Linux's probe */
+	int gx = smmu_rc ? -1 : gpu_power_gx();
+	uint32_t a = rd(GR(0x4d2));             /* RBBM_ALWAYSON_COUNTER_LO */
+	spin_us(1000);
+	uint32_t b = rd(GR(0x4d2));
+	printf("A9Y GPU: power %x smmu %d gx %x, cx gdsc %x gx gdsc %x, alwayson %x -> %x\n", rc,
+	    smmu_rc, gx, rd(gpucc + GPUCC_CX_GDSC), rd(gpucc + GPUCC_GX_GDSC), a, b);
+	if (gx || a == b) {
+		return;
+	}
+	if (gpu_start() == 0) {
+		gpu_selftest();
+	}
+}
+
+void
+a9y_gpu_init(void)
+{
+	thread_t thread;
+	uint32_t sweetgpu = 0;
+
+	/* sweetgpu=1: bsd/dev/sweet_gpu.c (over sweet_a5xx.c) owns the GPU */
+	if (PE_parse_boot_argn("sweetgpu", &sweetgpu, sizeof(sweetgpu)) && sweetgpu) {
+		return;
+	}
+	if (!PE_parse_boot_argn("a9ygpufw", &gpufw_pa, sizeof(gpufw_pa)) || !gpufw_pa) {
+		printf("A9Y GPU: no a9ygpufw= from the shim, not touching the GPU\n");
+		return;
+	}
+	if (kernel_thread_start(gpu_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_A9Y18QLTE */
diff --git a/bsd/dev/a9y_i2cbb.c b/bsd/dev/a9y_i2cbb.c
new file mode 100644
index 0000000..8e2cf4f
--- /dev/null
+++ b/bsd/dev/a9y_i2cbb.c
@@ -0,0 +1,132 @@
+/*
+ * a9y18qlte bit-banged I2C (see a9y_i2cbb.h). Open drain by hand: a line is
+ * pulled low with the GPIO's output enabled and its output value 0, and
+ * released (pulled up on the board) with the output disabled. ~100 kHz.
+ * One mutex for all buses: they are short register transfers.
+ */
+#if defined(ARM64_BOARD_CONFIG_A9Y18QLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include "a9y_i2cbb.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define TLMM_OE         (1u << 9)
+
+static LCK_GRP_DECLARE(a9y_bb_grp, "a9y_i2cbb");
+static LCK_MTX_DECLARE(a9y_bb_lock, &a9y_bb_grp);
+
+static void
+bb_line(uintptr_t cfg, int high)
+{
+	*(volatile uint32_t *)(cfg + 4) = 0;            /* output value 0 when driven */
+	*(volatile uint32_t *)cfg = high ? 0 : TLMM_OE; /* gpio function, OE = pull low */
+	delay(5);
+}
+
+static int
+bb_in(uintptr_t cfg)
+{
+	return *(volatile uint32_t *)(cfg + 4) & 1;
+}
+
+static void
+bb_start(struct a9y_bb_bus *b)
+{
+	bb_line(b->sda, 1);
+	bb_line(b->scl, 1);
+	bb_line(b->sda, 0);
+	bb_line(b->scl, 0);
+}
+
+static void
+bb_stop(struct a9y_bb_bus *b)
+{
+	bb_line(b->sda, 0);
+	bb_line(b->scl, 1);
+	bb_line(b->sda, 1);
+}
+
+static int
+bb_write_byte(struct a9y_bb_bus *b, uint8_t v)
+{
+	for (int i = 7; i >= 0; i--) {
+		bb_line(b->sda, (v >> i) & 1);
+		bb_line(b->scl, 1);
+		bb_line(b->scl, 0);
+	}
+	bb_line(b->sda, 1);
+	bb_line(b->scl, 1);
+	int ack = !bb_in(b->sda);
+	bb_line(b->scl, 0);
+	return ack;
+}
+
+static uint8_t
+bb_read_byte(struct a9y_bb_bus *b, int ack)
+{
+	uint8_t v = 0;
+	bb_line(b->sda, 1);
+	for (int i = 0; i < 8; i++) {
+		bb_line(b->scl, 1);
+		v = (uint8_t)(v << 1 | bb_in(b->sda));
+		bb_line(b->scl, 0);
+	}
+	bb_line(b->sda, !ack);
+	bb_line(b->scl, 1);
+	bb_line(b->scl, 0);
+	bb_line(b->sda, 1);
+	return v;
+}
+
+static int
+bb_map(struct a9y_bb_bus *b)
+{
+	if (!b->sda) {
+		b->sda = ml_io_map(b->sda_pa, 0x1000);
+	}
+	if (!b->scl) {
+		b->scl = ml_io_map(b->scl_pa, 0x1000);
+	}
+	return b->sda && b->scl ? 0 : -1;
+}
+
+int
+a9y_bb_read(struct a9y_bb_bus *b, uint8_t addr, uint8_t reg, uint8_t *buf, uint32_t n)
+{
+	lck_mtx_lock(&a9y_bb_lock);
+	int ok = bb_map(b) == 0;
+	if (ok) {
+		bb_start(b);
+		ok = bb_write_byte(b, (uint8_t)(addr << 1)) && bb_write_byte(b, reg);
+		bb_start(b);
+		ok = ok && bb_write_byte(b, (uint8_t)(addr << 1 | 1));
+		for (uint32_t i = 0; ok && i < n; i++) {
+			buf[i] = bb_read_byte(b, i + 1 < n);
+		}
+		bb_stop(b);
+	}
+	lck_mtx_unlock(&a9y_bb_lock);
+	return ok ? 0 : -1;
+}
+
+int
+a9y_bb_write(struct a9y_bb_bus *b, uint8_t addr, uint8_t reg, const uint8_t *buf, uint32_t n)
+{
+	lck_mtx_lock(&a9y_bb_lock);
+	int ok = bb_map(b) == 0;
+	if (ok) {
+		bb_start(b);
+		ok = bb_write_byte(b, (uint8_t)(addr << 1)) && bb_write_byte(b, reg);
+		for (uint32_t i = 0; ok && i < n; i++) {
+			ok = bb_write_byte(b, buf[i]);
+		}
+		bb_stop(b);
+	}
+	lck_mtx_unlock(&a9y_bb_lock);
+	return ok ? 0 : -1;
+}
+#endif /* ARM64_BOARD_CONFIG_A9Y18QLTE */
diff --git a/bsd/dev/a9y_i2cbb.h b/bsd/dev/a9y_i2cbb.h
new file mode 100644
index 0000000..15046c0
--- /dev/null
+++ b/bsd/dev/a9y_i2cbb.h
@@ -0,0 +1,32 @@
+/*
+ * a9y18qlte bit-banged I2C over SDM660 TLMM GPIOs (bsd/dev/a9y_i2cbb.c), for
+ * the buses Linux runs with i2c-gpio: i2c@22 (s2dos03, touch AVDD) and
+ * i2c@24 (SM5705 fuel gauge).
+ */
+#ifndef A9Y_I2CBB_H
+#define A9Y_I2CBB_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* TLMM config page of a GPIO: tiles NORTH 0x03900000, SOUTH 0x03100000, 0x1000 per GPIO */
+#define A9Y_TLMM_NORTH(gpio)    (0x03900000u + 0x1000u * (gpio))
+#define A9Y_TLMM_SOUTH(gpio)    (0x03100000u + 0x1000u * (gpio))
+
+struct a9y_bb_bus {
+	uint32_t sda_pa, scl_pa;        /* TLMM config pages of SDA and SCL */
+	uintptr_t sda, scl;             /* mapped on first use */
+};
+
+/* Register read/write of an 8-bit-register device; 0 on success (all bytes acked). */
+int a9y_bb_read(struct a9y_bb_bus *bus, uint8_t addr, uint8_t reg, uint8_t *buf, uint32_t n);
+int a9y_bb_write(struct a9y_bb_bus *bus, uint8_t addr, uint8_t reg, const uint8_t *buf, uint32_t n);
+
+/* SM5705 fuel gauge (bsd/dev/a9y_sm5705.c): percent x10, mV, mA (positive charging) */
+int a9y_sm5705_read(unsigned *permille, unsigned *mv, int *ma);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/a9y_keys.c b/bsd/dev/a9y_keys.c
new file mode 100644
index 0000000..bf7474e
--- /dev/null
+++ b/bsd/dev/a9y_keys.c
@@ -0,0 +1,85 @@
+/*
+ * a9y18qlte (Galaxy A9 2018) hardware keys, polled like sweet_keys.c, over
+ * the SDM660 SPMI arbiter v3 reads of bsd/dev/sweet_spmi.c (read only):
+ *   power        PM660 PON INT_RT_STS (SID 0, 0x0810) bit 0, KPDPWR
+ *   volume down  the same register, bit 1, RESIN
+ *   volume up    PM660L GPIO 7 (SID 2, 0xc600), active low (gpio_keys vol_up)
+ *   Bixby        PM660L GPIO 8 (SID 2, 0xc700), active low (key_wink): logged only
+ * Which GPIO register follows the pin depends on how the bootloader left it:
+ * STATUS1 (+0x08) bit 0 is used, and every change of the raw values is logged.
+ */
+#if defined(ARM64_BOARD_CONFIG_A9Y18QLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+
+extern void IOSleep(unsigned int milliseconds);
+extern void sweet_hid_key(int key, int down);
+void a9y_keys_init(void);
+
+#define PON_RT          0x0810u
+#define VOLUP_GPIO      0xc600u
+#define BIXBY_GPIO      0xc700u
+#define GPIO_STATUS1    0x08u
+#define GPIO_RT         0x10u
+#define GPIO_MODE       0x40u
+#define GPIO_PULL       0x42u
+#define GPIO_EN         0x46u
+
+enum { KEY_POWER, KEY_VOLUP, KEY_VOLDOWN };
+
+static void
+keys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int state[3] = { 0, 0, 0 };
+	uint32_t last = 0xffffffffu;
+
+	for (;;) {
+		uint8_t pon = 0, up_s = 0, up_rt = 0, bx_s = 0;
+		bool ok = sweet_spmi_read(0, PON_RT, &pon) == 0 &&
+		    sweet_spmi_read(2, VOLUP_GPIO + GPIO_STATUS1, &up_s) == 0 &&
+		    sweet_spmi_read(2, VOLUP_GPIO + GPIO_RT, &up_rt) == 0 &&
+		    sweet_spmi_read(2, BIXBY_GPIO + GPIO_STATUS1, &bx_s) == 0;
+		if (!ok) {
+			IOSleep(1000);
+			continue;
+		}
+		uint32_t raw = (uint32_t)pon | (uint32_t)up_s << 8 | (uint32_t)up_rt << 16 | (uint32_t)bx_s << 24;
+		if (raw != last) {
+			printf("A9Y KEYS: pon %#x volup status1 %#x rt %#x bixby status1 %#x\n",
+			    pon, up_s, up_rt, bx_s);
+			last = raw;
+		}
+		int now[3] = { !!(pon & 1u), !(up_s & 1u), !!(pon & 2u) };
+		for (int k = 0; k < 3; k++) {
+			if (now[k] != state[k]) {
+				state[k] = now[k];
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		IOSleep(20);
+	}
+}
+
+void
+a9y_keys_init(void)
+{
+	thread_t thread;
+	uint8_t mode = 0, pull = 0, en = 0;
+
+	if (sweet_spmi_init() != 0) {
+		printf("A9Y KEYS: no SPMI\n");
+		return;
+	}
+	(void)sweet_spmi_read(2, VOLUP_GPIO + GPIO_MODE, &mode);
+	(void)sweet_spmi_read(2, VOLUP_GPIO + GPIO_PULL, &pull);
+	(void)sweet_spmi_read(2, VOLUP_GPIO + GPIO_EN, &en);
+	printf("A9Y KEYS: volume up GPIO 7 mode %#x pull %#x en %#x\n", mode, pull, en);
+	if (kernel_thread_start(keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_A9Y18QLTE */
diff --git a/bsd/dev/a9y_rpm.c b/bsd/dev/a9y_rpm.c
new file mode 100644
index 0000000..d010535
--- /dev/null
+++ b/bsd/dev/a9y_rpm.c
@@ -0,0 +1,386 @@
+/*
+ * a9y18qlte (SDM660) RPM clock votes over GLINK, polled: ABL leaves the RPM's bus clocks where it booted (bimc, the
+ * DDR, measured at 676 MHz where Linux's cpubw table goes to 1804 MHz) and nothing under XNU asks for more. Ported
+ * from the Pixel 1 port's bsd/dev/sweet_rpm.c (joranv1/ios-sailfish 0100, 0146, 0147; MSM8996, the same transport):
+ *   transport  DT qcom,glink-rpm-native-xprt: RPM message RAM 0x778000 (0x7000 bytes, TOC "grt0" in its last 256
+ *              bytes naming the ap2r and r2ap FIFOs: tail, head, data), doorbell 0x17911008 bit 0. Intentless edge.
+ *   protocol   qcom_glink_rpm.c / qcom_glink_native.c: VERSION -> VERSION_ACK, OPEN "rpm_requests" both ways +
+ *              OPEN_ACK, TX_DATA {cmd, lcid, 0, chunk, left} + payload, 8-byte aligned.
+ *   requests   smd-rpm.c: "req" header, {msg_id, set (0 active, 1 sleep), type, id, len} + KVPs; the answer carries
+ *              "msg#" and, on failure, "err" + text.
+ * The RPM acks rate votes and ignores them until clock scaling is on (clk-smd-rpm.c clk_smd_rpm_enable_scaling).
+ * From then on it goes by the AP's votes, so first every sdm660 RPM clock (clk-smd-rpm.c sdm660_clks) is voted on at
+ * its maximum in both sets, as Linux's handoff does; scaling is turned on only if every one of those was acked.
+ * Boot-arg a9yddr=0 leaves the RPM alone. Message RAM: 32-bit accesses only.
+ */
+#if defined(ARM64_BOARD_CONFIG_A9Y18QLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+bool a9y_rpm_bus_max(void);
+
+#define RPM_MSGRAM_PA   0x00778000u
+#define RPM_MSGRAM_SIZE 0x7000u
+#define RPM_IPC_PA      0x17911000u     /* APCS IPC, +0x8 bit 0: the RPM's doorbell */
+#define RPM_TOC_MAGIC   0x67727430u     /* grt0 */
+#define RPM_FIFO_AP2R   0x61703272u
+#define RPM_FIFO_R2AP   0x72326170u
+#define RPM_LCID        1u
+
+#define CMD_VERSION       0u
+#define CMD_VERSION_ACK   1u
+#define CMD_OPEN          2u
+#define CMD_CLOSE         3u
+#define CMD_OPEN_ACK      4u
+#define CMD_TX_DATA       9u
+#define CMD_CLOSE_ACK     11u
+#define CMD_TX_DATA_CONT  12u
+#define CMD_READ_NOTIF    13u
+
+#define KEY_RATE        0x007a484bu     /* "KHz " */
+#define KEY_ENABLE      0x62616e45u     /* "Enab" */
+#define KEY_SWEN        0x6e657773u     /* "swen" */
+#define KEY_PCCB        0x62636370u     /* "pccb" */
+#define TYPE_MISC       0x306b6c63u     /* clk0 */
+#define TYPE_BUS        0x316b6c63u     /* clk1 */
+#define TYPE_MEM        0x326b6c63u     /* clk2 */
+#define TYPE_MMAXI      0x69786d6du     /* mmxi */
+#define TYPE_IPA        0x00617069u     /* ipa */
+#define TYPE_CE         0x00006563u     /* ce */
+#define TYPE_AGGR       0x72676761u     /* aggr */
+#define TYPE_CLKA       0x616b6c63u     /* clka: XO buffers */
+
+struct rpm_fifo {
+	volatile uint32_t *tail, *head, *data;
+	uint32_t len;
+};
+
+static struct {
+	struct rpm_fifo tx, rx;
+	vm_offset_t ipc;
+	bool mapped, up, remote_open, open_acked;
+	uint32_t rcid, msg_id;
+	uint32_t resp[64];              /* last complete TX_DATA payload */
+	uint32_t resp_len;
+	bool resp_ready;
+} rpm;
+
+static uint32_t
+fifo_avail_rx(void)
+{
+	uint32_t head = *rpm.rx.head, tail = *rpm.rx.tail;
+	return head >= tail ? head - tail : rpm.rx.len - tail + head;
+}
+
+static void
+fifo_peek(uint32_t off, uint32_t *buf, uint32_t n)
+{
+	uint32_t pos = (*rpm.rx.tail + off) % rpm.rx.len;
+	for (uint32_t i = 0; i < n / 4; i++) {
+		buf[i] = rpm.rx.data[pos / 4];
+		pos = (pos + 4) % rpm.rx.len;
+	}
+}
+
+static void
+fifo_advance(uint32_t n)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*rpm.rx.tail = (*rpm.rx.tail + n) % rpm.rx.len;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+rpm_kick(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(rpm.ipc + 0x8) = 1u;
+}
+
+/* n is a multiple of 4; the message is padded to 8 bytes. */
+static bool
+rpm_send(const uint32_t *w, uint32_t n)
+{
+	uint32_t total = (n + 7u) & ~7u;
+	for (unsigned tries = 0;; tries++) {
+		uint32_t head = *rpm.tx.head, tail = *rpm.tx.tail;
+		uint32_t avail = tail <= head ? rpm.tx.len - head + tail : tail - head;
+		if (avail > total) {
+			break;
+		}
+		if (tries == 100) {
+			printf("A9Y RPM: tx fifo full (head %u tail %u)\n", head, tail);
+			return false;
+		}
+		delay(1000);
+	}
+	uint32_t pos = *rpm.tx.head;
+	for (uint32_t i = 0; i < total / 4; i++) {
+		rpm.tx.data[pos / 4] = i < n / 4 ? w[i] : 0u;
+		pos = (pos + 4) % rpm.tx.len;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*rpm.tx.head = pos;
+	rpm_kick();
+	return true;
+}
+
+static bool
+rpm_send_cmd(uint32_t cmd, uint32_t param1, uint32_t param2)
+{
+	uint32_t w[2] = { cmd | (param1 << 16), param2 };
+	return rpm_send(w, sizeof(w));
+}
+
+static bool
+rpm_send_open(void)
+{
+	static const char name[] = "rpm_requests";
+	uint32_t w[2 + 4] = { CMD_OPEN | (RPM_LCID << 16), sizeof(name) };
+	memcpy(&w[2], name, sizeof(name));
+	return rpm_send(w, 8u + ((sizeof(name) + 3u) & ~3u));
+}
+
+/* Handle one incoming message; false when nothing (complete) is there. */
+static bool
+rpm_rx_one(void)
+{
+	uint32_t avail = fifo_avail_rx(), h[4];
+	if (avail < 8) {
+		return false;
+	}
+	fifo_peek(0, h, 8);
+	uint32_t cmd = h[0] & 0xffffu, p1 = h[0] >> 16, p2 = h[1];
+	switch (cmd) {
+	case CMD_VERSION:
+		fifo_advance(8);
+		(void)rpm_send_cmd(CMD_VERSION_ACK, 1, 0);
+		break;
+	case CMD_VERSION_ACK:
+		fifo_advance(8);
+		if (p1 != 1) {
+			printf("A9Y RPM: version ack %u features %#x\n", p1, p2);
+		} else if (p2 != 0) {
+			(void)rpm_send_cmd(CMD_VERSION, 1, 0);
+		} else if (!rpm.up) {
+			rpm.up = true;
+			(void)rpm_send_open();
+		}
+		break;
+	case CMD_OPEN: {
+		uint32_t len = 8u + ((p2 + 7u) & ~7u), name[8] = { 0 };
+		if (avail < len) {
+			return false;
+		}
+		fifo_peek(8, name, MIN(p2 + 3u, 31u) & ~3u);
+		fifo_advance(len);
+		if (strncmp((const char *)name, "rpm_requests", 13) == 0) {
+			rpm.rcid = p1;
+			rpm.remote_open = true;
+			(void)rpm_send_cmd(CMD_OPEN_ACK, p1, 0);
+		} else {
+			printf("A9Y RPM: ignoring remote open of '%.24s'\n", (const char *)name);
+		}
+		break;
+	}
+	case CMD_OPEN_ACK:
+		fifo_advance(8);
+		if (p1 == RPM_LCID) {
+			rpm.open_acked = true;
+		}
+		break;
+	case CMD_CLOSE:
+		fifo_advance(8);
+		(void)rpm_send_cmd(CMD_CLOSE_ACK, p1, 0);
+		if (p1 == rpm.rcid) {
+			rpm.remote_open = false;
+		}
+		break;
+	case CMD_TX_DATA:
+	case CMD_TX_DATA_CONT: {
+		if (avail < 16) {
+			return false;
+		}
+		fifo_peek(0, h, 16);
+		uint32_t chunk = h[2], left = h[3];
+		if (avail < 16 + chunk) {
+			return false;
+		}
+		if (cmd == CMD_TX_DATA) {
+			rpm.resp_len = 0;
+		}
+		uint32_t take = MIN(chunk, sizeof(rpm.resp) - rpm.resp_len) & ~3u;
+		fifo_peek(16, (uint32_t *)((uint8_t *)rpm.resp + rpm.resp_len), take);
+		rpm.resp_len += take;
+		fifo_advance((16u + chunk + 7u) & ~7u);
+		if (left == 0) {
+			rpm.resp_ready = true;
+		}
+		break;
+	}
+	case CMD_READ_NOTIF:
+		fifo_advance(8);
+		rpm_kick();
+		break;
+	default:
+		/* intent/rx-done/signals: not used on this intentless edge */
+		printf("A9Y RPM: rx cmd %u p1 %u p2 %#x dropped\n", cmd, p1, p2);
+		fifo_advance(8);
+		break;
+	}
+	return true;
+}
+
+/* Poll up to ms for cond. */
+#define RPM_POLL(ms, cond) ({                                   \
+	unsigned _i;                                            \
+	for (_i = 0; _i < (ms) && !(cond); _i++) {              \
+	        while (rpm_rx_one()) {                          \
+	        }                                               \
+	        if (!(cond)) {                                  \
+	                delay(1000);                            \
+	        }                                               \
+	}                                                       \
+	(cond);                                                 \
+})
+
+static bool
+rpm_open(void)
+{
+	if (rpm.up && rpm.remote_open && rpm.open_acked) {
+		return true;
+	}
+	if (!rpm.mapped) {
+		vm_offset_t ram = ml_io_map(RPM_MSGRAM_PA, RPM_MSGRAM_SIZE);
+		rpm.ipc = ml_io_map(RPM_IPC_PA, 0x1000);
+		if (!ram || !rpm.ipc) {
+			printf("A9Y RPM: MMIO mapping failed\n");
+			return false;
+		}
+		volatile uint32_t *toc = (volatile uint32_t *)(ram + RPM_MSGRAM_SIZE - 256);
+		uint32_t count = toc[1];
+		if (toc[0] != RPM_TOC_MAGIC || count > 20) {
+			printf("A9Y RPM: bad TOC magic %#x count %u\n", toc[0], count);
+			return false;
+		}
+		for (uint32_t i = 0; i < count; i++) {
+			uint32_t id = toc[2 + 3 * i], off = toc[3 + 3 * i], size = toc[4 + 3 * i];
+			struct rpm_fifo *f = id == RPM_FIFO_AP2R ? &rpm.tx : id == RPM_FIFO_R2AP ? &rpm.rx : NULL;
+			if (f == NULL || off + size > RPM_MSGRAM_SIZE || (size & 3u)) {
+				continue;
+			}
+			f->tail = (volatile uint32_t *)(ram + off);
+			f->head = f->tail + 1;
+			f->data = f->tail + 2;
+			f->len = size;
+		}
+		if (!rpm.tx.data || !rpm.rx.data) {
+			printf("A9Y RPM: TOC has no ap2r/r2ap fifo\n");
+			return false;
+		}
+		printf("A9Y RPM: tx len %u head %u tail %u, rx len %u head %u tail %u\n",
+		    rpm.tx.len, *rpm.tx.head, *rpm.tx.tail, rpm.rx.len, *rpm.rx.head, *rpm.rx.tail);
+		rpm.mapped = true;
+	}
+	/* As Linux: our write index and read index start over, then negotiate. */
+	rpm.up = rpm.remote_open = rpm.open_acked = false;
+	*rpm.tx.head = 0;
+	*rpm.rx.tail = 0;
+	(void)rpm_send_cmd(CMD_VERSION, 1, 0);
+	bool ok = RPM_POLL(1000u, rpm.up && rpm.remote_open && rpm.open_acked);
+	printf("A9Y RPM: link %s (version %d, remote open %d rcid %u, open ack %d)\n",
+	    ok ? "up" : "FAILED", rpm.up, rpm.remote_open, rpm.rcid, rpm.open_acked);
+	return ok;
+}
+
+/*
+ * One request in set `set` (0 active, 1 sleep): type, id and one {key, 4, value} record. True if the RPM acked it
+ * ("msg#" = our id) without "err".
+ */
+static bool
+rpm_request(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t value)
+{
+	uint32_t msg = ++rpm.msg_id;
+	uint32_t w[14] = {
+		CMD_TX_DATA | (RPM_LCID << 16), 0, sizeof(w) - 16u, 0,
+		0x00716572u, 20u + 12u,                         /* "req", length */
+		msg, set, type, id, 12u,
+		key, 4u, value,
+	};
+	rpm.resp_ready = false;
+	if (!rpm_send(w, sizeof(w))) {
+		return false;
+	}
+	if (!RPM_POLL(1000u, rpm.resp_ready)) {
+		printf("A9Y RPM: %08x %u: no answer\n", type, id);
+		return false;
+	}
+	/* "req", length, then {type, length, data} records */
+	bool acked = false, err = false;
+	uint32_t words = MIN(rpm.resp_len / 4, 2u + rpm.resp[1] / 4), i = 2;
+	while (i + 2 <= words) {
+		uint32_t rtype = rpm.resp[i], len = rpm.resp[i + 1];
+		if (rtype == 0x2367736du && rpm.resp[i + 2] == msg) {
+			acked = true;
+		} else if (rtype == 0x00727265u) {
+			char text[32] = { 0 };
+			memcpy(text, &rpm.resp[i + 2], MIN(len, sizeof(text) - 1));
+			printf("A9Y RPM: %08x %u: error '%s'\n", type, id, text);
+			err = true;
+		}
+		i += 2 + (len + 3) / 4;
+	}
+	return acked && !err;
+}
+
+/* clk-smd-rpm.c sdm660_clks: rate clocks at INT_MAX kHz (the RPM rounds down), branches and XO buffers on. */
+static const struct {
+	uint32_t type, id, key, value;
+} rpm_handoff[] = {
+	{ TYPE_MISC, 0, KEY_ENABLE, 1 },                /* cxo */
+	{ TYPE_BUS, 1, KEY_RATE, 0x7fffffffu },         /* snoc */
+	{ TYPE_BUS, 2, KEY_RATE, 0x7fffffffu },         /* cnoc */
+	{ TYPE_BUS, 0, KEY_RATE, 0x7fffffffu },         /* cnoc_periph */
+	{ TYPE_MEM, 0, KEY_RATE, 0x7fffffffu },         /* bimc (DDR) */
+	{ TYPE_MMAXI, 0, KEY_RATE, 0x7fffffffu },       /* mmssnoc_axi */
+	{ TYPE_IPA, 0, KEY_RATE, 0x7fffffffu },         /* ipa */
+	{ TYPE_CE, 0, KEY_RATE, 0x7fffffffu },          /* ce1 */
+	{ TYPE_AGGR, 2, KEY_RATE, 0x7fffffffu },        /* aggre2_noc */
+	{ TYPE_MISC, 1, KEY_ENABLE, 1 },                /* qdss */
+	{ TYPE_CLKA, 4, KEY_SWEN, 1 },                  /* rf_clk1 */
+	{ TYPE_CLKA, 0xb, KEY_SWEN, 1 },                /* div_clk1 */
+	{ TYPE_CLKA, 1, KEY_SWEN, 1 },                  /* ln_bb_clk1 */
+	{ TYPE_CLKA, 2, KEY_SWEN, 1 },                  /* ln_bb_clk2 */
+	{ TYPE_CLKA, 3, KEY_SWEN, 1 },                  /* ln_bb_clk3 */
+	{ TYPE_CLKA, 4, KEY_PCCB, 1 },                  /* rf_clk1_pin */
+	{ TYPE_CLKA, 1, KEY_PCCB, 1 },                  /* ln_bb_clk1_pin */
+	{ TYPE_CLKA, 2, KEY_PCCB, 1 },                  /* ln_bb_clk2_pin */
+	{ TYPE_CLKA, 3, KEY_PCCB, 1 },                  /* ln_bb_clk3_pin */
+};
+
+/* Every RPM clock at its maximum, then clock scaling on. Called once, from the GPU bring-up thread. */
+bool
+a9y_rpm_bus_max(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("a9yddr", &on, sizeof(on));
+	if (!on || !rpm_open()) {
+		return false;
+	}
+	unsigned failed = 0;
+	for (unsigned i = 0; i < sizeof(rpm_handoff) / sizeof(rpm_handoff[0]); i++) {
+		for (uint32_t set = 0; set < 2; set++) {
+			failed += !rpm_request(1 - set, rpm_handoff[i].type, rpm_handoff[i].id, rpm_handoff[i].key,
+			    rpm_handoff[i].value);
+		}
+	}
+	bool ok = failed == 0 && rpm_request(1, TYPE_MISC, 2, KEY_ENABLE, 1) && rpm_request(0, TYPE_MISC, 2, KEY_ENABLE, 1);
+	printf("A9Y RPM: clock handoff (%u votes failed), scaling %s\n", failed,
+	    ok ? "on" : failed ? "left off" : "FAILED");
+	return ok;
+}
+#endif /* ARM64_BOARD_CONFIG_A9Y18QLTE */
diff --git a/bsd/dev/a9y_sm5705.c b/bsd/dev/a9y_sm5705.c
new file mode 100644
index 0000000..3da81c7
--- /dev/null
+++ b/bsd/dev/a9y_sm5705.c
@@ -0,0 +1,43 @@
+/*
+ * a9y18qlte battery gauge: the SM5705 fuel gauge (0x71) on the bit-banged
+ * i2c@24 (SDA GPIO 55, SCL GPIO 56, TLMM SOUTH tile). This is what Android
+ * reports (sm5705-fuelgauge); the PM660's own FG gen3 has no battery profile
+ * here. Decoding as Samsung's sm5705_fuelgauge.c, words little endian:
+ *   SOC     0x05: high byte percent, low byte /256 (capacity_max 1000: no scaling)
+ *   VOLTAGE 0x07: bits 13:11 volts, 10:0 /2048
+ *   CURRENT 0x08: bits 12:11 amps, 10:0 /2048, bit 15 negative (discharging)
+ */
+#if defined(ARM64_BOARD_CONFIG_A9Y18QLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include "a9y_i2cbb.h"
+
+#define SM5705_FG       0x71
+
+static struct a9y_bb_bus sm5705_bus = { A9Y_TLMM_SOUTH(55), A9Y_TLMM_SOUTH(56), 0, 0 };
+
+static int
+sm5705_word(uint8_t reg, uint16_t *v)
+{
+	uint8_t b[2];
+	if (a9y_bb_read(&sm5705_bus, SM5705_FG, reg, b, 2)) {
+		return -1;
+	}
+	*v = (uint16_t)(b[0] | b[1] << 8);
+	return 0;
+}
+
+int
+a9y_sm5705_read(unsigned *permille, unsigned *mv, int *ma)
+{
+	uint16_t soc, volt, cur;
+	if (sm5705_word(0x05, &soc) || sm5705_word(0x07, &volt) || sm5705_word(0x08, &cur)) {
+		return -1;
+	}
+	*permille = ((soc & 0xff00u) >> 8) * 10 + ((soc & 0x00ffu) * 10) / 256;
+	*mv = ((volt & 0x3800u) >> 11) * 1000 + ((volt & 0x07ffu) * 1000) / 2048;
+	int c = (int)(((cur & 0x1800u) >> 11) * 1000 + ((cur & 0x07ffu) * 1000) / 2048);
+	*ma = (cur & 0x8000u) ? -c : c;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_A9Y18QLTE */
diff --git a/bsd/dev/a9y_touch.c b/bsd/dev/a9y_touch.c
new file mode 100644
index 0000000..952bc22
--- /dev/null
+++ b/bsd/dev/a9y_touch.c
@@ -0,0 +1,373 @@
+/*
+ * a9y18qlte (Galaxy A9 2018, SDM660) touchscreen: Zinitix ZT7548 at 0x20 on
+ * BLSP1 QUP4 I2C (i2c@c178000: SDA/SCL GPIO 14/15, IRQ GPIO 67, low while a
+ * report waits). Bring-up as Samsung's zinitix_zt75xx_ts.c does it, first
+ * worked out in the probe shim (a9-ios shim.c touch_probe):
+ *   - AVDD: s2dos03 LDO3 (3.0 V), on the bit-banged i2c@22 (SDA GPIO 66,
+ *     SCL GPIO 70, address 0x60); off until something turns it on.
+ *   - GCC BLSP1 AHB vote and QUP4 I2C core clock, the pins' blsp_i2c4 function.
+ *   - QUP in FIFO mode with v1 tags, polled (Linux i2c-qup.c), 400 kHz.
+ *   - bt532_power_sequence() (vendor enable, chip code e548, NVM init,
+ *     firmware start) and mini_init_touch() (cover OPEN = 0x0200: 0 means a
+ *     closed flip cover and no touches).
+ * A kernel thread polls GPIO 67 and hands panel-pixel contacts to SweetHID.
+ */
+#if defined(ARM64_BOARD_CONFIG_A9Y18QLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "a9y_i2cbb.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void IOSleep(unsigned int milliseconds);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void a9y_touch_init(void);
+
+#define GCC_VOTE_PA             0x00152000u     /* + 0x004: BLSP1 AHB, bit 17 */
+#define GCC_QUP4_PA             0x0011f000u     /* + 0x008: QUP4 I2C core CBCR */
+#define TLMM_PA                 0x03900000u     /* NORTH tile, 0x1000 per GPIO */
+#define TLMM_FIRST              14              /* GPIOs 14..67 are mapped */
+#define TLMM_LAST               67
+#define QUP4_PA                 0x0c178000u
+
+#define QUP_CONFIG              0x000
+#define QUP_STATE               0x004
+#define QUP_IO_MODE             0x008
+#define QUP_SW_RESET            0x00c
+#define QUP_OPERATIONAL         0x018
+#define QUP_OUT_FIFO            0x110
+#define QUP_MX_WRITE_CNT        0x150
+#define QUP_MX_READ_CNT         0x208
+#define QUP_IN_FIFO             0x218
+#define QUP_I2C_CLK_CTL         0x400
+#define QUP_I2C_STATUS          0x404
+#define QUP_STATE_VALID         0x4
+#define QUP_RESET               0
+#define QUP_RUN                 1
+#define QUP_PAUSE               3
+#define QUP_OUT_NOT_EMPTY       (1u << 4)
+#define QUP_IN_NOT_EMPTY        (1u << 5)
+#define I2C_STATUS_ERROR_MASK   0x38000fcu
+#define I2C_STATUS_BUS_ACTIVE   (1u << 8)
+#define TAG_START               (1u << 8)
+#define TAG_DATA                (2u << 8)
+#define TAG_STOP                (3u << 8)
+#define TAG_REC                 (4u << 8)
+
+#define ZT_ADDR                 0x20
+#define ZT_FINGERS              5
+#define S2DOS03                 0x60
+#define BB_SDA                  66
+#define BB_SCL                  70
+#define TOUCH_IRQ               67
+
+static vm_offset_t gcc_vote, gcc_qup4, tlmm, qup;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+static vm_offset_t
+tlmm_cfg(int gpio)
+{
+	return tlmm + 0x1000u * (uint32_t)(gpio - TLMM_FIRST);
+}
+
+/* ---- s2dos03 over the bit-banged i2c@22 (bsd/dev/a9y_i2cbb.c) ---- */
+
+static struct a9y_bb_bus s2dos_bus = { A9Y_TLMM_NORTH(BB_SDA), A9Y_TLMM_NORTH(BB_SCL), 0, 0 };
+
+static int
+s2dos_read(uint8_t reg, uint8_t *v)
+{
+	return a9y_bb_read(&s2dos_bus, S2DOS03, reg, v, 1);
+}
+
+static int
+s2dos_write(uint8_t reg, uint8_t v)
+{
+	return a9y_bb_write(&s2dos_bus, S2DOS03, reg, &v, 1);
+}
+
+/*
+ * LDO3 (REG_REG_EN 0x03 bit 2) at 3.0 V (REG_LDO3_CFG 0x12: 0.6 V + 96 * 25 mV),
+ * off first: the chip may be running from an earlier bring-up (the probe
+ * shim), and only answers the power sequence's vendor commands from reset.
+ */
+static int
+touch_power(void)
+{
+	uint8_t en = 0, cfg = 0, stat = 0;
+	if (s2dos_read(0x03, &en) || s2dos_read(0x12, &cfg)) {
+		return -1;
+	}
+	if ((cfg & 0x7f) != 96) {
+		s2dos_write(0x12, (uint8_t)((cfg & 0x80) | 96));
+	}
+	if (en & 0x04) {
+		s2dos_write(0x03, en & ~0x04);
+		IOSleep(50);	/* CHIP_OFF_DELAY */
+	}
+	s2dos_write(0x03, en | 0x04);
+	IOSleep(50);	/* CHIP_ON_DELAY */
+	(void)s2dos_read(0x02, &stat);
+	return (stat & 0x04) ? 0 : -1;	/* LDO3 power good */
+}
+
+/* ---- QUP4 I2C ---- */
+
+static int
+qup_set_state(uint32_t st)
+{
+	for (int i = 0; i < 1000 && !(rd(qup + QUP_STATE) & QUP_STATE_VALID); i++) {
+		delay(1);
+	}
+	wr(qup + QUP_STATE, st);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t s = rd(qup + QUP_STATE);
+		if ((s & QUP_STATE_VALID) && (s & 3) == st) {
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+/* One message, START..STOP: write n bytes of buf, or read n bytes into it. */
+static int
+qup_msg(int rdmsg, uint8_t *buf, uint32_t n)
+{
+	wr(qup + QUP_SW_RESET, 1);
+	if (qup_set_state(QUP_RESET)) {
+		return -1;
+	}
+	wr(qup + QUP_CONFIG, (2u << 8) | 15);                 /* I2C mini core, 16-bit words */
+	wr(qup + QUP_IO_MODE, (1u << 14) | (1u << 15));       /* FIFO, pack/unpack */
+	if (rdmsg) {
+		wr(qup + QUP_MX_READ_CNT, n);
+	} else {
+		wr(qup + QUP_MX_WRITE_CNT, n + 1);
+	}
+	if (qup_set_state(QUP_RUN)) {
+		return -2;
+	}
+	wr(qup + QUP_I2C_CLK_CTL, (3u << 8) | 21);            /* 19.2 MHz in, 400 kHz */
+	if (qup_set_state(QUP_PAUSE)) {
+		return -3;
+	}
+	if (rdmsg) {
+		wr(qup + QUP_OUT_FIFO, (TAG_START | (ZT_ADDR << 1) | 1) | ((TAG_REC | n) << 16));
+	} else {
+		uint32_t val = TAG_START | (ZT_ADDR << 1);
+		for (uint32_t i = 0, idx = 1; i < n; i++, idx++) {
+			uint32_t t = (i == n - 1 ? TAG_STOP : TAG_DATA) | buf[i];
+			val = (idx & 1) ? val | (t << 16) : t;
+			if ((idx & 1) || i == n - 1) {
+				wr(qup + QUP_OUT_FIFO, val);
+			}
+		}
+	}
+	if (qup_set_state(QUP_RUN)) {
+		return -4;
+	}
+	uint32_t got = 0;
+	int err = -6;
+	for (int t = 0; t < 20000; t++) {
+		uint32_t st = rd(qup + QUP_I2C_STATUS), op = rd(qup + QUP_OPERATIONAL);
+		if (st & I2C_STATUS_ERROR_MASK) {
+			err = -5;
+			break;
+		}
+		if (rdmsg) {
+			while (got < n && (rd(qup + QUP_OPERATIONAL) & QUP_IN_NOT_EMPTY)) {
+				uint32_t word = rd(qup + QUP_IN_FIFO);
+				buf[got++] = word & 0xff;
+				if (got < n) {
+					buf[got++] = (word >> 16) & 0xff;
+				}
+			}
+			if (got == n) {
+				err = 0;
+				break;
+			}
+		} else if (!(op & QUP_OUT_NOT_EMPTY) && !(st & I2C_STATUS_BUS_ACTIVE)) {
+			err = 0;
+			break;
+		}
+		delay(5);
+	}
+	(void)qup_set_state(QUP_RESET);
+	return err;
+}
+
+static int
+zt_cmd(uint16_t reg)
+{
+	uint8_t pkt[2] = { reg & 0xff, reg >> 8 };
+	return qup_msg(0, pkt, 2);
+}
+
+static int
+zt_write(uint16_t reg, uint16_t v)
+{
+	uint8_t pkt[4] = { reg & 0xff, reg >> 8, v & 0xff, v >> 8 };
+	return qup_msg(0, pkt, 4);
+}
+
+static int
+zt_read(uint16_t reg, uint8_t *v, uint32_t n)
+{
+	int rc = zt_cmd(reg);
+	delay(50);	/* DELAY_FOR_TRANSCATION */
+	return rc ? rc : qup_msg(1, v, n);
+}
+
+static int
+touch_setup(void)
+{
+	gcc_vote = ml_io_map(GCC_VOTE_PA, 0x1000);
+	gcc_qup4 = ml_io_map(GCC_QUP4_PA, 0x1000);
+	tlmm = ml_io_map(TLMM_PA + 0x1000u * TLMM_FIRST, 0x1000u * (TLMM_LAST - TLMM_FIRST + 1));
+	qup = ml_io_map(QUP4_PA, 0x1000);
+	if (!gcc_vote || !gcc_qup4 || !tlmm || !qup) {
+		return -1;
+	}
+	wr(gcc_vote + 0x004, rd(gcc_vote + 0x004) | (1u << 17));
+	wr(gcc_qup4 + 0x008, rd(gcc_qup4 + 0x008) | 1);
+	for (int i = 0; i < 1000 && (rd(gcc_qup4 + 0x008) >> 31); i++) {
+		delay(1);
+	}
+	wr(tlmm_cfg(14), 2u << 2);      /* blsp_i2c4, 2 mA, no pull */
+	wr(tlmm_cfg(15), 2u << 2);
+	wr(tlmm_cfg(TOUCH_IRQ), 0);     /* input, no pull */
+
+	/* bt532_power_control(POWER_ON_SEQUENCE): power cycle, then the sequence; 3 retries */
+	uint8_t code[2] = { 0 };
+	int tries;
+	for (tries = 0; tries < 4; tries++) {
+		if (touch_power()) {
+			printf("A9Y TOUCH: s2dos03 LDO3 did not come up\n");
+			continue;
+		}
+		code[0] = code[1] = 0;
+		if (zt_write(0xc000, 1) == 0 && zt_read(0xcc00, code, 2) == 0 &&
+		    (code[0] | code[1] << 8) == 0xe548) {
+			break;
+		}
+	}
+	if (tries == 4) {
+		printf("A9Y TOUCH: no ZT7548 (chip code %x)\n", code[0] | code[1] << 8);
+		return -3;
+	}
+	zt_cmd(0xc004);
+	delay(10);
+	zt_write(0xc002, 1);
+	IOSleep(2);
+	zt_write(0xc001, 1);
+	IOSleep(150);   /* FIRMWARE_ON_DELAY */
+
+	/* mini_init_touch() */
+	uint8_t fw[2] = { 0 };
+	(void)zt_read(0x0012, fw, 2);
+	zt_cmd(0x0000);                 /* SWRESET */
+	zt_write(0x0010, 0);            /* TOUCH_POINT_MODE */
+	zt_write(0x023e, 0x0200);       /* COVER_OPEN */
+	zt_write(0x0116, 0);            /* optional mode */
+	zt_write(0x00f0, 0x003f);       /* count change, down, move, up, palm, palm reject */
+	for (uint16_t r = 0x00ab; r <= 0x00af; r++) {
+		zt_write(r, 0);         /* AOD window and LPM off */
+	}
+	for (int i = 0; i < 10; i++) {
+		zt_cmd(0x0003);         /* CLEAR_INT_STATUS */
+	}
+	printf("A9Y TOUCH: ZT7548 firmware %x up, polling GPIO %d\n", fw[0] | fw[1] << 8, TOUCH_IRQ);
+	return 0;
+}
+
+static void
+touch_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	uint32_t active = 0;
+	int x[ZT_FINGERS] = { 0 }, y[ZT_FINGERS] = { 0 };
+	int sent_x[ZT_FINGERS] = { 0 }, sent_y[ZT_FINGERS] = { 0 };
+	/*
+	 * Moves go to iOS at most a9ytouchhz (default 60, 0 = every report) times
+	 * a second, the newest position, and only when it changed; downs and ups
+	 * at once. Each event costs backboardd's HID pipeline and SpringBoard more
+	 * CPU than a frame shows (ios-sailfish 0182).
+	 */
+	uint64_t move_gap = 0, move_last = 0;
+	uint32_t hz = 60;
+
+	if (touch_setup() != 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("a9ytouchhz", &hz, sizeof(hz));
+	if (hz) {
+		nanoseconds_to_absolutetime(NSEC_PER_SEC / hz, &move_gap);
+	}
+	for (;;) {
+		if (rd(tlmm_cfg(TOUCH_IRQ) + 4) & 1) {
+			IOSleep(5);
+			continue;
+		}
+		uint8_t p[4 + 6 * ZT_FINGERS];
+		if (zt_read(0x0080, p, sizeof(p)) == 0) {
+			uint32_t now = 0;
+			uint64_t t = mach_absolute_time();
+			bool move_ok = t - move_last >= move_gap;
+			for (int f = 0; f < ZT_FINGERS; f++) {
+				const uint8_t *c = p + 4 + 6 * f;
+				/* SUB_BIT_EXIST without SUB_BIT_UP: the finger is on the panel */
+				if ((c[5] & 0x01) && !(c[5] & 0x08)) {
+					x[f] = c[0] | c[1] << 8;
+					y[f] = c[2] | c[3] << 8;
+					now |= 1u << f;
+					if (!(active & (1u << f)) ||
+					    ((x[f] != sent_x[f] || y[f] != sent_y[f]) && move_ok)) {
+						sweet_hid_touch(f, 1, x[f], y[f]);
+						sent_x[f] = x[f];
+						sent_y[f] = y[f];
+						move_last = t;
+					}
+				} else if (active & (1u << f)) {
+					/* the last position first if it was held back: a lift where the finger last was
+					 * reported, not a jump to it (swipe velocity on the lock screen, flicks) */
+					if (x[f] != sent_x[f] || y[f] != sent_y[f]) {
+						sweet_hid_touch(f, 1, x[f], y[f]);
+					}
+					sweet_hid_touch(f, 0, x[f], y[f]);
+				}
+			}
+			active = now;
+		}
+		zt_cmd(0x0003);
+	}
+}
+
+void
+a9y_touch_init(void)
+{
+	thread_t thread;
+	int on = 1;
+
+	(void)PE_parse_boot_argn("a9ytouch", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (kernel_thread_start(touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_A9Y18QLTE */
diff --git a/bsd/dev/sweet_a5xx.c b/bsd/dev/sweet_a5xx.c
new file mode 100644
index 0000000..60d9fd3
--- /dev/null
+++ b/bsd/dev/sweet_a5xx.c
@@ -0,0 +1,952 @@
+/*
+ * Adreno 512 core for the a9y18qlte (SDM660): the sweet_a6xx.h core API
+ * (same a6_* names, so bsd/dev/sweet_gpu.c and the accelerator above it run
+ * unchanged), built instead of sweet_a6xx.c on this board. The bring-up is
+ * the one the probe shim (tools/a9y/shim, gpu_probe) and bsd/dev/a9y_gpu.c
+ * proved on the phone; this file has no GMU, HFI or RPMh stages (the A5xx
+ * has none of them):
+ *
+ *   - CX: GCC GPU AHB/BIMC branches, GPUCC CXO/rbbmtimer/gfx3d (XO), CX
+ *     GDSC. The rbbmtimer branch never reports on; harmless.
+ *   - SMMU (arm,smmu-kgsl@5040000, qsmmuv2, qcom,skip-init), behind the
+ *     hypervisor: it refuses bypass and a mask spanning streams 0 and 2,
+ *     and a TLB sync (global or per bank) never completes for us, the
+ *     write itself stalls. As Linux leaves it: micro MMU halt +
+ *     attach-impl-defs + resume, sCR0 fault reporting, exact SMRs, stream
+ *     0 -> CB0 and stream 2 -> CB1 (the CP's fetches while still secure),
+ *     both over the one page table. TLB invalidates are posted and not
+ *     synced (a6_tlb_flush).
+ *   - GX: block reset, GMEM reset pulse, clamp off, GX GDSC, gfx3d.
+ *   - CP: a530 PM4/PFP microcode, kgsl's a5xx_start() values for the a512
+ *     (without the fetch queue thresholds the CP never reads the ring),
+ *     ME_INIT while secure, the a512_zap shader through TZ PAS, then
+ *     CP_SET_SECURE_MODE(0).
+ *
+ * The zap shader's region is outside XNU's RAM (TZ locks it: a speculative
+ * CPU access through the physmap would be a fatal XPU violation), in the
+ * Linux image the shim did not boot. The pool's SQE area holds the PM4
+ * (+0x200000) and PFP (+0x208000) microcode.
+ *
+ * GPU page tables: 39-bit iovas from level 1, non-cacheable walks (this
+ * SMMU does not snoop).
+ *
+ * a6_blit_ib: the a512's 2D engine copies nothing (tools/a9y/gpu/kgsltest),
+ * so there is no blit stream: it returns 0 dwords. The display's present is
+ * a5_fit_ib instead, a 3D draw: Mesa's fd5 GLES one for
+ * tools/a9y/glreplay/host/fit.c, captured as a template (sweet_a5xx_fit.h,
+ * rd2tmpl.py) and relocated into the pool.
+ */
+#if defined(KERNEL) && defined(ARM64_BOARD_CONFIG_A9Y18QLTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include "sweet_a6xx.h"
+
+#define rd32		a6_rd
+#define wr32		a6_wr
+
+static void wr64(uint64_t pa, uint64_t v)
+{
+	wr32(pa, (uint32_t)v);
+	wr32(pa + 4, (uint32_t)(v >> 32));
+}
+
+static int wait_bit(uint64_t pa, uint32_t mask, int set, unsigned us)
+{
+	for (unsigned i = 0; i <= us; i++) {
+		if (!!(rd32(pa) & mask) == set)
+			return 0;
+		if (i < us)
+			a6_delay_us(1);
+	}
+	return -1;
+}
+
+static void zero_pa(uint64_t pa, uint64_t size)
+{
+	static const uint8_t z[0x4000];
+	for (uint64_t o = 0; o < size; o += sizeof(z))
+		a6_write(pa + o, z, (size_t)(size - o < sizeof(z) ? size - o : sizeof(z)));
+}
+
+/* ---- registers ---- */
+
+#define GCC		0x00100000ull
+#define GCC_GPU_AHB	(GCC + 0x71004)
+#define GCC_GPU_BIMC	(GCC + 0x71010)
+#define GCC_BIMC_GFX	(GCC + 0x7106c)
+#define GCC_GPU_GPLL0	(GCC + 0x5200c)		/* bit 4: GPLL0 to GPUCC (vote) */
+#define GFX_LDO_PWRSWITCH	0x0506e01cull	/* msm_gfx_ldo.c PWRSWITCH_CTRL */
+#define GFX_LDO_STATUS	0x0506e028ull		/* PWRSWITCH_STATUS */
+#define GFX_MEM_ACC	0x01fcf004ull		/* gfx mem-acc, bit 0 */
+#define GPUCC		A6_GPUCC
+#define GPUCC_CXO	(GPUCC + 0x1020)
+#define GPUCC_GFX3D_RCG	(GPUCC + 0x1070)
+#define GPUCC_GFX3D	(GPUCC + 0x1098)
+#define GPUCC_RBBM_RCG	(GPUCC + 0x10b0)
+#define GPUCC_RBBM	(GPUCC + 0x10d0)
+#define GPUCC_GX_MISC	(GPUCC + 0x0130)	/* bit 4 GMEM reset, bit 0 clamp IO */
+#define GPUCC_CX_GDSCR	(GPUCC + 0x1004)
+#define GPUCC_GX_BCR	(GPUCC + 0x1090)
+#define GPUCC_GX_GDSCR	(GPUCC + 0x1094)
+#define GREG(o)		A6_GREG(o)
+
+#define SMMU		A6_SMMU
+#define SMMU_GR1	(SMMU + 0x1000)
+#define SMMU_CB(n)	A6_SMMU_CB(n)
+#define SMR(n)		(SMMU + 0x800 + 4 * (n))
+#define S2CR(n)		(SMMU + 0xc00 + 4 * (n))
+#define CBAR(n)		(SMMU_GR1 + 4 * (n))
+#define CBA2R(n)	(SMMU_GR1 + 0x800 + 4 * (n))
+#define CB_SCTLR	0x00
+#define CB_ACTLR	0x04
+#define CB_TCR2		0x10
+#define CB_TTBR0	0x20
+#define CB_TCR		0x30
+#define CB_MAIR0	0x38
+#define CB_FSR		0x58
+#define CB_FAR		0x60
+#define CB_FSYNR0	0x68
+#define CB_TLBIALL	0x618
+#define TCR2_VAL	((7u << 15) | 2u)	/* SEP upstream (else bit 31 picks TTBR1), 40-bit PA */
+#define TCR_VAL		(25u | (1u << 23))	/* 39-bit iovas, 4K, non-cacheable walks, no TTBR1 */
+#define GPU_NSTREAM	2			/* stream n -> SMR n -> CB n */
+
+#define CP_RB_BASE	0x800
+#define CP_RB_CNTL	0x802
+#define CP_RB_RPTR	0x806
+#define CP_RB_WPTR	0x807
+#define CP_ME_CNTL	0x832
+#define CP_PFP_BASE	0x835
+#define CP_PM4_BASE	0x838
+#define CP_HW_FAULT	0xb1a
+#define RBBM_STATUS	0x4f5
+#define RBBM_INT_STATUS	0x4e1
+#define RBBM_ALWAYSON	0x4d2
+#define SECVID_TRUST	0xf400
+
+#define OFF_PM4		A6_OFF_SQE
+#define OFF_PFP		(A6_OFF_SQE + 0x8000)
+
+static bool is_on(uint64_t gdscr)
+{
+	return (rd32(gdscr) >> 31) & 1;
+}
+
+bool a6_cx_up(void)
+{
+	return is_on(GPUCC_CX_GDSCR);
+}
+
+bool a6_gx_up(void)
+{
+	return is_on(GPUCC_GX_GDSCR);
+}
+
+bool a6_cp_running(const struct a6_gpu *g)
+{
+	(void)g;
+	return a6_gx_up() && rd32(GREG(CP_ME_CNTL)) == 0;
+}
+
+void a6_init_state(struct a6_gpu *g, uint64_t pool_pa)
+{
+	memset(g, 0, sizeof(*g));
+	g->pool_pa = pool_pa;
+	g->gmu_smr = g->gmu_cb = -1;
+	g->gpu_smr = g->gpu_cb = 0;
+}
+
+/* ---- stage 1: clocks and CX power ---- */
+
+static int branch_on(uint64_t cbcr)
+{
+	wr32(cbcr, rd32(cbcr) | 1);
+	return wait_bit(cbcr, 1u << 31, 0, 1000);	/* CLK_OFF clear */
+}
+
+/* RCG to XO, divider 1, latched with UPDATE; root forced on if asked */
+static int rcg_xo(uint64_t rcgr, bool force_root)
+{
+	wr32(rcgr + 4, 0);
+	wr32(rcgr, rd32(rcgr) | 1 | (force_root ? 2 : 0));
+	return wait_bit(rcgr, 1, 0, 1000);
+}
+
+static int gdsc_on(uint64_t gdscr)
+{
+	wr32(gdscr, rd32(gdscr) & ~1u);
+	return wait_bit(gdscr, 1u << 31, 1, 2000);
+}
+
+static int power_cx(void)
+{
+	int rc = branch_on(GCC_GPU_AHB) | branch_on(GCC_GPU_BIMC) | branch_on(GCC_BIMC_GFX);
+	rc |= branch_on(GPUCC_CXO) << 1;
+	rc |= rcg_xo(GPUCC_RBBM_RCG, false) << 2;
+	(void)branch_on(GPUCC_RBBM);		/* never reports on: harmless */
+	rc |= rcg_xo(GPUCC_GFX3D_RCG, true) << 3;
+	rc |= gdsc_on(GPUCC_CX_GDSCR) << 4;
+	a6_log("cx: rc %x, cx gdsc %x\n", rc, rd32(GPUCC_CX_GDSCR));
+	return a6_cx_up() ? 0 : -1;
+}
+
+/* GX: block reset pulse, GMEM reset pulse, clamp off, GX GDSC, core clock */
+static int power_gx(void)
+{
+	wr32(GPUCC_GX_BCR, rd32(GPUCC_GX_BCR) | 1);
+	a6_delay_us(1);
+	wr32(GPUCC_GX_BCR, rd32(GPUCC_GX_BCR) & ~1u);
+	wr32(GPUCC_GX_MISC, rd32(GPUCC_GX_MISC) | (1u << 4));
+	a6_delay_us(1);
+	wr32(GPUCC_GX_MISC, rd32(GPUCC_GX_MISC) & ~(1u << 4));
+	wr32(GPUCC_GX_MISC, rd32(GPUCC_GX_MISC) & ~1u);
+	int rc = gdsc_on(GPUCC_GX_GDSCR) | branch_on(GPUCC_GFX3D) << 1;
+	uint32_t a = rd32(GREG(RBBM_ALWAYSON));
+	a6_delay_us(100);
+	uint32_t b = rd32(GREG(RBBM_ALWAYSON));
+	a6_log("gx: rc %x, gx gdsc %x, alwayson %x -> %x\n", rc, rd32(GPUCC_GX_GDSCR), a, b);
+	return a6_gx_up() && a != b ? 0 : -1;
+}
+
+/*
+ * The core clock. Bring-up leaves gfx3d on XO (19.2 MHz). With mhz (struct a6_gpu perf_level on this board),
+ * GPLL0 (600 MHz, from GCC) divided by the RCG's half-integer divider instead: 240 MHz stays below Linux's
+ * lowest corner (266 MHz at CX LOW_SVS), and the core runs from VDD_CX through the gfx LDO's bypass switch,
+ * which the display already holds at SVS or above. Back on XO if the RCG does not latch.
+ */
+#include "sweet_spmi.h"
+
+/*
+ * Read only: the CPU clusters as ABL left them, for a CPU clock under XNU (nothing scales it here; a dependent-add
+ * loop runs at ~1.2 GHz where Linux goes to 1.84 / 2.2 GHz). Each cluster's PLL (mode, L = rate / 19.2 MHz, user
+ * control with its post divider), the mux in front of it (APCS RCG: PLL or GPLL0), whether OSM drives it, and
+ * PM660's SMPS set points (the APC rails are among them, under SAW / CPRh).
+ */
+static void log_cpu_clocks(void)
+{
+	static const struct { const char *name; uint64_t pll, rcg; } cl[2] = {
+		{ "pwrcl (silver)", 0x17916000ull, 0x17911050ull },
+		{ "perfcl (gold)", 0x17816000ull, 0x17811050ull },
+	};
+	for (unsigned i = 0; i < 2; i++) {
+		uint32_t l = rd32(cl[i].pll + 4);
+		a6_log("cpu %s: pll mode %x L %u (%u MHz) user %x status %x, rcg cmd %x cfg %x\n", cl[i].name,
+		       rd32(cl[i].pll), l & 0xff, (l & 0xff) * 192 / 10, rd32(cl[i].pll + 0xc), rd32(cl[i].pll + 0x2c),
+		       rd32(cl[i].rcg), rd32(cl[i].rcg + 4));
+	}
+	a6_log("cpu osm: version %x, enable %x / %x, index %x / %x\n", rd32(0x179c0000ull), rd32(0x179c1004ull),
+	       rd32(0x179c3004ull), rd32(0x179c1150ull), rd32(0x179c3150ull));
+	char line[160], *e = line;
+	for (unsigned s = 1; s <= 6; s++) {
+		uint8_t lo = 0, hi = 0, en = 0;
+		unsigned base = 0x1400 + 0x300 * (s - 1);
+		if (sweet_spmi_init() || sweet_spmi_read(1, base + 0x40, &lo) || sweet_spmi_read(1, base + 0x41, &hi) ||
+		    sweet_spmi_read(1, base + 0x46, &en))
+			e += snprintf(e, line + sizeof(line) - e, " S%u ?", s);
+		else
+			e += snprintf(e, line + sizeof(line) - e, " S%u %u mV%s", s, (unsigned)(hi << 8 | lo), en & 0x80 ? "" : " (off)");
+	}
+	a6_log("cpu rails, PM660 SMPS set points:%s\n", line);
+}
+
+/*
+ * Read only: a clock's rate through the GCC debug mux (gcc-sdm660.c gcc_debug_mux, clk-debug.c measure): select it in
+ * GCC_DEBUG_CLK_CTL (0x62000; bit 16 enable, post divider 1), count it against XO/4 (XO_DIV4_CBCR 0x43008) in
+ * CLOCK_FRQ_MEASURE_CTL / STATUS (0x62004 / 8). Only these debug registers change, restored afterwards. For how ABL
+ * leaves the RPM's bus clocks: the Pixel 1 port (ios-sailfish 0145) found its DDR far below Linux's vote.
+ */
+#define GCC_DBG_CTL	(GCC + 0x62000)
+#define GCC_DBG_MEAS	(GCC + 0x62004)
+#define GCC_DBG_STATUS	(GCC + 0x62008)
+#define GCC_XO_DIV4	(GCC + 0x43008)
+
+static uint32_t measure_run(uint32_t ticks)
+{
+	wr32(GCC_DBG_MEAS, ticks);
+	(void)wait_bit(GCC_DBG_STATUS, 1u << 25, 0, 1000);
+	wr32(GCC_DBG_MEAS, (1u << 20) | ticks);
+	(void)wait_bit(GCC_DBG_STATUS, 1u << 25, 1, 100000);
+	return rd32(GCC_DBG_STATUS) & 0x1ffffffu;
+}
+
+static unsigned measure_mhz(uint32_t sel)
+{
+	uint32_t ctl = rd32(GCC_DBG_CTL), cbcr = rd32(GCC_XO_DIV4);
+	wr32(GCC_DBG_CTL, (ctl & ~0xf3ffu) | (sel & 0x3ffu) | (1u << 16));
+	wr32(GCC_XO_DIV4, cbcr | 1u);
+	uint32_t s = measure_run(0x1000), f = measure_run(0x10000);
+	wr32(GCC_XO_DIV4, cbcr);
+	wr32(GCC_DBG_CTL, ctl);
+	if (f == s)
+		return 0;				/* not running */
+	return (unsigned)((((uint64_t)f * 10 + 15) * 4800000 / (0x10000 * 10 + 35)) / 1000000);
+}
+
+bool a9y_rpm_bus_max(void);
+
+static void log_bus_clocks(void)
+{
+	static const struct { const char *name; uint32_t sel; } c[] = {
+		{ "bimc (DDR)", 0x19d }, { "snoc", 0x000 }, { "cnoc", 0x00e }, { "bimc_gfx", 0x0ac },
+	};
+	char line[160], *e = line;
+	for (unsigned i = 0; i < sizeof(c) / sizeof(c[0]); i++)
+		e += snprintf(e, line + sizeof(line) - e, " %s %u", c[i].name, measure_mhz(c[i].sel));
+	a6_log("bus clocks, MHz as measured:%s\n", line);
+}
+
+/*
+ * ABL leaves the gold cluster on GPLL0 (its mux at 0x401) with its PLL at L 32: ~600 MHz, where Linux's OSM runs it
+ * up to 2.2 GHz. With mhz (boot-arg sweetgoldmhz) the PLL is relocked at one of Linux's corner frequencies and the
+ * mux moved to its early output, as OSM's sequencer does (it rewrites L live). The rails stay as ABL set them
+ * (868-872 mV): Linux's perfcl ceilings are 788 mV at 1401.6 MHz and 868 mV at 1747.2 MHz, so both are within.
+ * mhz 1 (the default) picks by the rails as read: 1747 when PM660 S1-S3 all hold 868 mV or more, 1401 at 788 mV or
+ * more, else ABL's clock; 0 keeps ABL's. Both ran clean (a dependent-add bench: eight threads at ~1.24 GHz each,
+ * twice ABL's clocks).
+ */
+static void gold_clock(unsigned mhz)
+{
+	const uint64_t pll = 0x17816000ull, rcg = 0x17811050ull;
+	if (mhz == 1) {
+		unsigned low = 0xffff;
+		for (unsigned s = 1; s <= 3; s++) {
+			uint8_t lo = 0, hi = 0;
+			unsigned base = 0x1400 + 0x300 * (s - 1);
+			if (sweet_spmi_read(1, base + 0x40, &lo) || sweet_spmi_read(1, base + 0x41, &hi))
+				low = 0;
+			else if ((unsigned)(hi << 8 | lo) < low)
+				low = hi << 8 | lo;
+		}
+		mhz = low >= 868 && low != 0xffff ? 1747 : low >= 788 && low != 0xffff ? 1401 : 0;
+		a6_log("cpu gold: rails S1-S3 at %u mV or more: %s\n", low == 0xffff ? 0 : low,
+		       mhz ? (mhz == 1747 ? "1747 MHz" : "1401 MHz") : "unread or low, ABL's clock kept");
+	}
+	unsigned l = mhz == 1113 ? 58 : mhz == 1401 ? 73 : mhz == 1747 ? 91 : 0;
+	if (!l) {
+		if (mhz)
+			a6_log("cpu gold: %u MHz is not one of 1113, 1401, 1747: left as ABL set it\n", mhz);
+		return;
+	}
+	wr32(rcg + 4, 0x401);			/* GPLL0 while the PLL relocks */
+	wr32(rcg, rd32(rcg) | 1);
+	(void)wait_bit(rcg, 1, 0, 1000);
+	wr32(pll, 0);
+	wr32(pll + 4, l);
+	wr32(pll, 2);				/* bypass off */
+	a6_delay_us(10);
+	wr32(pll, 6);				/* out of reset */
+	a6_delay_us(75);
+	wr32(pll, 7);				/* output on */
+	int locked = wait_bit(pll + 0x2c, 1u << 16, 1, 1000) == 0;
+	if (locked) {
+		wr32(rcg + 4, 0x501);		/* the PLL's early output, divider 1 (silver's setting) */
+		wr32(rcg, rd32(rcg) | 1);
+		locked = wait_bit(rcg, 1, 0, 1000) == 0;
+	}
+	a6_log("cpu gold: PLL L %u (%u MHz) %s, rcg cfg %x\n", l, l * 192 / 10,
+	       locked ? "locked, cluster on it" : "did not lock: cluster stays on GPLL0", rd32(rcg + 4));
+}
+
+static void gfx_clock(unsigned mhz)
+{
+	uint8_t s3[2][4];
+	for (unsigned sid = 2; sid <= 3; sid++) {
+		static const unsigned reg[4] = { 0x1a04, 0x1a05, 0x1a40, 0x1a41 };	/* PM660L S3 (CX) */
+		for (unsigned i = 0; i < 4; i++)
+			if (sweet_spmi_init() || sweet_spmi_read(sid, reg[i], &s3[sid - 2][i]))
+				s3[sid - 2][i] = 0xee;
+	}
+	a6_log("rail: gfx ldo pwrswitch %x status %x, mem-acc %x; PM660L S3 type/subtype/range/code sid2 "
+	       "%02x %02x %02x %02x, sid3 %02x %02x %02x %02x\n", rd32(GFX_LDO_PWRSWITCH), rd32(GFX_LDO_STATUS),
+	       rd32(GFX_MEM_ACC), s3[0][0], s3[0][1], s3[0][2], s3[0][3], s3[1][0], s3[1][1], s3[1][2], s3[1][3]);
+	if (mhz == 0)
+		return;
+	uint32_t hid = (1200 + mhz / 2) / mhz - 1;	/* divider 2 * d - 1, d in halves */
+	if (hid < 1)
+		hid = 1;
+	if (hid > 31)
+		hid = 31;
+	wr32(GCC_GPU_GPLL0, rd32(GCC_GPU_GPLL0) | 1u << 4);
+	a6_delay_us(10);
+	wr32(GPUCC_GFX3D_RCG + 4, 5u << 8 | hid);		/* source 5: GPLL0_OUT_MAIN */
+	wr32(GPUCC_GFX3D_RCG, rd32(GPUCC_GFX3D_RCG) | 1);
+	int rc = wait_bit(GPUCC_GFX3D_RCG, 1, 0, 1000);
+	if (rc)
+		(void)rcg_xo(GPUCC_GFX3D_RCG, true);
+	a6_log("gfx3d: GPLL0 / %u%s = %u MHz: %s (cfg %x)\n", (hid + 1) / 2, (hid & 1) ? "" : ".5", 1200 / (hid + 1),
+	       rc ? "did not latch, back on XO" : "ok", rd32(GPUCC_GFX3D_RCG + 4));
+}
+
+/* ---- SMMU ---- */
+
+static const uint32_t smmu_impl[][2] = {
+	{ 0x6000, 0x2378 }, { 0x6060, 0x1055 }, { 0x678c, 0x08 }, { 0x6794, 0x28 },
+	{ 0x6800, 0x06 }, { 0x6900, 0x3ff }, { 0x6924, 0x204 }, { 0x6928, 0x11000 },
+	{ 0x6930, 0x800 }, { 0x6960, 0xffffffff }, { 0x6b64, 0x1a5551 }, { 0x6b68, 0x9a82a382 },
+};
+static const uint32_t gpu_sid[GPU_NSTREAM] = { 0, 2 };
+
+/* As Linux's arm_smmu_device_reset() + qsmmuv2_device_reset() with qcom,skip-init, minus the sync */
+static int smmu_reset(void)
+{
+	uint32_t cr0 = rd32(SMMU), idr0 = rd32(SMMU + 0x20);
+	if ((cr0 & 1) || (idr0 & 0xff) < GPU_NSTREAM || (rd32(SMR(0)) >> 31) || (rd32(SMR(1)) >> 31)) {
+		a6_log("smmu: not as at boot (cr0 %x idr0 %x smr0 %x smr1 %x)\n", cr0, idr0, rd32(SMR(0)),
+		       rd32(SMR(1)));
+		return -1;
+	}
+	wr32(SMMU + 0x6000, rd32(SMMU + 0x6000) | (1u << 2));	/* LOCAL_HALT_REQ */
+	(void)wait_bit(SMMU + 0x6000, 1u << 3, 1, 1000);		/* IDLE */
+	for (unsigned k = 0; k < sizeof(smmu_impl) / sizeof(smmu_impl[0]); k++)
+		wr32(SMMU + smmu_impl[k][0], smmu_impl[k][1]);
+	wr32(SMMU + 0x6000, rd32(SMMU + 0x6000) & ~(1u << 2));
+	wr32(SMMU + 0x48, rd32(SMMU + 0x48));		/* sGFSR clear */
+	wr32(SMMU + 0x68, 0xffffffff);			/* TLBIALLNSNH */
+	wr32(SMMU + 0x6c, 0xffffffff);			/* TLBIALLH */
+	cr0 |= 1u << 1 | 1u << 2 | 1u << 4 | 1u << 5;	/* GFRE GFIE GCFGFRE GCFGFIE */
+	cr0 |= 1u << 11 | 1u << 12;			/* VMIDPNE PTM */
+	cr0 &= ~(1u | 1u << 13 | 3u << 14);		/* CLIENTPD FB BSU */
+	cr0 |= 3u << 22;				/* SHCFG NSH */
+	wr32(SMMU, cr0);
+	return 0;
+}
+
+static int smmu_banks(uint64_t ttbr0)
+{
+	int rc = 0;
+	for (uint32_t n = 0; n < GPU_NSTREAM; n++) {
+		uint64_t c = SMMU_CB(n);
+		wr32(c + CB_SCTLR, 0);
+		wr32(CBA2R(n), 1);				/* AArch64 descriptors */
+		/* S1 + S2 bypass, NSH, WB, VMID cb + 1 as Linux's arm-smmu */
+		wr32(CBAR(n), (1u << 16) | (0xfu << 12) | (3u << 8) | (n + 1));
+		wr32(c + CB_TCR2, TCR2_VAL);
+		wr64(c + CB_TTBR0, ttbr0);
+		wr32(c + CB_TCR, TCR_VAL);
+		wr32(c + CB_MAIR0, 0x0000ff44);			/* 0: normal NC, 1: WB */
+		wr32(c + CB_ACTLR, 0x70000000);			/* Qualcomm ISH/OSH/NSH */
+		wr32(c + CB_FSR, 0xffffffff);
+		wr32(c + CB_TLBIALL, 0);
+		wr32(c + CB_SCTLR, 1 | 2 | 4 | 0x20);		/* M TRE AFE CFRE */
+		/* SMR before S2CR, exact stream id; S2CR: translate, SHCFG NSH */
+		wr32(SMR(n), (1u << 31) | gpu_sid[n]);
+		wr32(S2CR(n), (3u << 8) | n);
+		if (!(rd32(SMR(n)) >> 31) || (rd32(S2CR(n)) & 0x300ff) != n)
+			rc = -1;
+		a6_log("smmu: stream %u -> smr%u %x s2cr %x cb%u cbar %x tcr %x tcr2 %x\n", gpu_sid[n], n,
+		       rd32(SMR(n)), rd32(S2CR(n)), n, rd32(CBAR(n)), rd32(c + CB_TCR), rd32(c + CB_TCR2));
+	}
+	return rc;
+}
+
+/* Posted, never synced: a TLB sync (global or per bank) stalls forever on this SMMU */
+void a6_tlb_flush(const struct a6_gpu *g)
+{
+	(void)g;
+	for (uint32_t n = 0; n < GPU_NSTREAM; n++)
+		wr32(SMMU_CB(n) + CB_TLBIALL, 0);
+	(void)rd32(SMMU_CB(0) + CB_SCTLR);
+}
+
+uint32_t a6_fault_status(const struct a6_gpu *g, uint64_t *far, uint32_t *fsynr0)
+{
+	(void)g;
+	uint32_t fsr = 0;
+	for (uint32_t n = 0; n < GPU_NSTREAM && !fsr; n++) {
+		uint64_t c = SMMU_CB(n);
+		fsr = rd32(c + CB_FSR) & A6_FSR_FAULT;
+		if (fsr && far)
+			*far = rd32(c + CB_FAR) | ((uint64_t)rd32(c + CB_FAR + 4) << 32);
+		if (fsr && fsynr0)
+			*fsynr0 = rd32(c + CB_FSYNR0);
+	}
+	return fsr;
+}
+
+int a6_clear_fault(const struct a6_gpu *g)
+{
+	uint64_t far = 0;
+	uint32_t syn = 0, fsr = a6_fault_status(g, &far, &syn);
+	if (!fsr)
+		return 0;
+	a6_log("clearing smmu fault: fsr %x far %llx fsynr0 %x\n", fsr, (unsigned long long)far, syn);
+	for (uint32_t n = 0; n < GPU_NSTREAM; n++)
+		wr32(SMMU_CB(n) + CB_FSR, rd32(SMMU_CB(n) + CB_FSR));
+	return 1;
+}
+
+/* ---- zap shader through TrustZone PAS ---- */
+
+#define PAS_GPU		13
+#define ZAP_REGION	0x82100000ull	/* 1 MB aligned (the segment's p_align), below XNU's RAM */
+#define ZAP_SIZE	0x2000u
+#define SCM_PIL(cmd)	(0x42000000ull | (2u << 8) | (cmd))
+
+static int64_t scm(uint32_t cmd, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1)
+{
+	uint64_t x[8] = { SCM_PIL(cmd), arginfo, a, b, c, 0, 0, 0 };
+	a6_smc(x);	/* sweet_smc: resumes interrupted calls */
+	if (r1)
+		*r1 = x[1];
+	return (int64_t)x[0];
+}
+
+static int zap_load(struct a6_gpu *g)
+{
+	uint32_t mlen, slen;
+	const uint8_t *mdt = a6_firmware("a512_zap.mdt", &mlen), *b02 = a6_firmware("a512_zap.b02", &slen);
+	if (!mdt || !b02 || slen > ZAP_SIZE || mlen > A6_OFF_GT_L1 - A6_OFF_ZAP_META)
+		return -1;
+	a6_write(a6_pool_pa(g, A6_OFF_ZAP_META), mdt, (mlen + 3) & ~3u);
+	int64_t rc1 = scm(1, 2 | (2u << 6), PAS_GPU, a6_pool_pa(g, A6_OFF_ZAP_META), 0, NULL);
+	int64_t rc2 = rc1 ? -1 : scm(2, 3, PAS_GPU, ZAP_REGION, ZAP_SIZE, NULL);
+	if (!rc1 && !rc2) {
+		static uint8_t seg[ZAP_SIZE];
+		memset(seg, 0, sizeof(seg));
+		memcpy(seg, b02, slen);
+		a6_write(ZAP_REGION, seg, ZAP_SIZE);
+	}
+	int64_t rc3 = rc1 || rc2 ? -1 : scm(5, 1, PAS_GPU, 0, 0, NULL);
+	a6_log("zap: init image %lld, mem setup %lld, auth and reset %lld\n", (long long)rc1, (long long)rc2,
+	       (long long)rc3);
+	return rc1 || rc2 || rc3 ? -1 : 0;
+}
+
+/* The zap shader is already in TrustZone after a GPU reset: resume it (Linux: SCM_GPU_ZAP_SHADER_RESUME) */
+static int zap_resume(void)
+{
+	uint64_t x[8] = { 0x42000000ull | (1u << 8) | 0x0a, 2, 0 /* resume */, PAS_GPU, 0, 0, 0, 0 };
+	a6_smc(x);
+	a6_log("zap: resume rc %lld\n", (long long)x[0]);
+	return x[0] ? -1 : 0;
+}
+
+/* ---- ring ---- */
+
+static uint32_t pm4_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^
+				  (v >> 24) ^ (v >> 28)))) & 1;
+}
+
+uint32_t a6_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000 | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7f) << 16) | (pm4_parity(op) << 23);
+}
+
+uint32_t a6_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000 | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffff) << 8) | (pm4_parity(reg) << 27);
+}
+
+/* RBBM_STATUS bit 31: GPU busy (a5xx.xml A5XX_RBBM_STATUS_GPU_BUSY_IGN_AHB is bit 31) */
+int a6_ring(struct a6_gpu *g, const uint32_t *dw, uint32_t n, const char *what, unsigned timeout_ms)
+{
+	if (n >= A6_RING_DW)
+		return -1;
+	uint32_t w = g->wptr, first = n < A6_RING_DW - w ? n : A6_RING_DW - w;
+	a6_write(a6_pool_pa(g, A6_OFF_RING) + 4ull * w, dw, 4ull * first);
+	if (first < n)
+		a6_write(a6_pool_pa(g, A6_OFF_RING), dw + first, 4ull * (n - first));
+	g->wptr = (w + n) % A6_RING_DW;
+	wr32(GREG(CP_RB_WPTR), g->wptr);
+	unsigned i;
+	for (i = 0; i < timeout_ms * 50 + 8; i++) {
+		if (rd32(GREG(CP_RB_RPTR)) == g->wptr)
+			break;
+		if (i >= 8)
+			a6_delay_us(20);
+	}
+	bool ok = i < timeout_ms * 50 + 8;
+	if (what || !ok)
+		a6_log("ring %s: rptr %x wptr %x status %x int %x hwfault %x trust %x %s\n", what ? what : "",
+		       rd32(GREG(CP_RB_RPTR)), g->wptr, rd32(GREG(RBBM_STATUS)), rd32(GREG(RBBM_INT_STATUS)),
+		       rd32(GREG(CP_HW_FAULT)), rd32(GREG(SECVID_TRUST)), ok ? "read" : "TIMEOUT");
+	return ok ? 0 : -1;
+}
+
+uint32_t a6_fence_read(const struct a6_gpu *g)
+{
+	uint32_t v = 0;
+	a6_read(a6_pool_pa(g, A6_OFF_SCRATCH), &v, 4);
+	return v;
+}
+
+/*
+ * Up to A6_SUBMIT_MAX IBs, wrapped as Linux's a5xx_submit: CCU invalidates, a timestamp of
+ * RBBM_ALWAYSON before and after, the IBs, WFI, then the fence by CACHE_FLUSH_TS.
+ */
+uint32_t a6_submit_ibs_async(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords, unsigned nib,
+			     unsigned timeout_ms)
+{
+	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
+	uint64_t ts = a6_pool_va(A6_OFF_SCRATCH + A6_TS_OFF) + 16ull * ((g->fence + 1) % A6_TS_SLOTS);
+	uint32_t dw[4 + 4 + 4 * A6_SUBMIT_MAX + 5 + 5], n = 0;
+	if (nib == 0 || nib > A6_SUBMIT_MAX)
+		return 0;
+	dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1);
+	dw[n++] = 0x18;				/* PC_CCU_INVALIDATE_DEPTH */
+	dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1);
+	dw[n++] = 0x19;				/* PC_CCU_INVALIDATE_COLOR */
+	dw[n++] = a6_pkt7(0x3e, 3);		/* CP_REG_TO_MEM RBBM_ALWAYSON, 2 dwords -> ts */
+	dw[n++] = RBBM_ALWAYSON | 2u << 18;
+	dw[n++] = (uint32_t)ts;
+	dw[n++] = (uint32_t)(ts >> 32);
+	for (unsigned i = 0; i < nib; i++) {
+		dw[n++] = a6_pkt7(A6_CP_INDIRECT_BUFFER, 3);
+		dw[n++] = (uint32_t)iova[i];
+		dw[n++] = (uint32_t)(iova[i] >> 32);
+		dw[n++] = dwords[i] & 0xfffff;
+	}
+	dw[n++] = a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0);
+	dw[n++] = a6_pkt7(0x3e, 3);		/* ... -> ts + 8 */
+	dw[n++] = RBBM_ALWAYSON | 2u << 18;
+	dw[n++] = (uint32_t)(ts + 8);
+	dw[n++] = (uint32_t)((ts + 8) >> 32);
+	dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 4);
+	dw[n++] = 0x04;				/* CACHE_FLUSH_TS: the fence lands once the caches are clean */
+	dw[n++] = (uint32_t)fva;
+	dw[n++] = (uint32_t)(fva >> 32);
+	dw[n++] = g->fence + 1;
+	for (unsigned i = 0; ; i++) {
+		uint32_t r = rd32(GREG(CP_RB_RPTR)), used = (g->wptr + A6_RING_DW - r) % A6_RING_DW;
+		if (used + n + 16 < A6_RING_DW)
+			break;
+		if (i >= timeout_ms * 50)
+			return 0;
+		a6_delay_us(20);
+	}
+	uint32_t w = g->wptr, first = n < A6_RING_DW - w ? n : A6_RING_DW - w;
+	a6_write(a6_pool_pa(g, A6_OFF_RING) + 4ull * w, dw, 4ull * first);
+	if (first < n)
+		a6_write(a6_pool_pa(g, A6_OFF_RING), dw + first, 4ull * (n - first));
+	g->wptr = (w + n) % A6_RING_DW;
+	wr32(GREG(CP_RB_WPTR), g->wptr);
+	return ++g->fence;
+}
+
+uint32_t a6_submit_ib_async(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
+{
+	return a6_submit_ibs_async(g, &iova, &dwords, 1, timeout_ms);
+}
+
+void a6_fence_force(struct a6_gpu *g)
+{
+	uint32_t v = g->fence;
+	a6_write(a6_pool_pa(g, A6_OFF_SCRATCH), &v, 4);
+}
+
+uint64_t a6_submit_time(const struct a6_gpu *g, uint32_t fence)
+{
+	uint64_t t[2] = { 0, 0 };
+	a6_read(a6_pool_pa(g, A6_OFF_SCRATCH + A6_TS_OFF) + 16ull * (fence % A6_TS_SLOTS), t, 16);
+	return t[1] > t[0] ? t[1] - t[0] : 0;
+}
+
+uint64_t a6_timestamp(const struct a6_gpu *g)
+{
+	(void)g;
+	uint32_t hi = rd32(GREG(RBBM_ALWAYSON + 1)), lo = rd32(GREG(RBBM_ALWAYSON));
+	uint32_t hi2 = rd32(GREG(RBBM_ALWAYSON + 1));
+	if (hi2 != hi)
+		lo = rd32(GREG(RBBM_ALWAYSON));
+	return (uint64_t)hi2 << 32 | lo;
+}
+
+bool a6_fence_done(const struct a6_gpu *g, uint32_t fence)
+{
+	return (int32_t)(a6_fence_read(g) - fence) >= 0;
+}
+
+int a6_submit_ib(struct a6_gpu *g, uint64_t iova, uint32_t dwords, unsigned timeout_ms)
+{
+	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
+	uint32_t fence = ++g->fence;
+	uint32_t dw[] = {
+		a6_pkt7(A6_CP_INDIRECT_BUFFER, 3), (uint32_t)iova, (uint32_t)(iova >> 32), dwords,
+		a6_pkt7(A6_CP_WAIT_FOR_IDLE, 0),
+		a6_pkt7(A6_CP_MEM_WRITE, 3), (uint32_t)fva, (uint32_t)(fva >> 32), fence,
+	};
+	if (a6_ring(g, dw, sizeof(dw) / 4, NULL, timeout_ms))
+		return -1;
+	for (unsigned i = 0; i < timeout_ms * 50 && a6_fence_read(g) != fence; i++)
+		a6_delay_us(20);
+	return a6_fence_read(g) != fence ? -1 : 0;
+}
+
+/* ---- GPU page tables (as sweet_a6xx.c) ---- */
+
+static void map_gpu_low(struct a6_gpu *g)
+{
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1), l2 = a6_pool_pa(g, A6_OFF_GT_L2);
+	zero_pa(l1, 0x2000);
+	wr64(l1 + 0, l2 | 3);		/* VA 0-1 GB */
+	for (uint64_t o = 0; o < A6_POOL_SIZE; o += 0x200000)	/* AP=01, NC, 2 MB blocks */
+		wr64(l2 + 8 * (((A6_GVA_POOL + o) >> 21) & 0x1ff),
+		     (g->pool_pa + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+	for (uint64_t o = 0; o < A6_FB_SIZE; o += 0x200000)
+		wr64(l2 + 8 * (((A6_GVA_FB + o) >> 21) & 0x1ff),
+		     (A6_FB_PA + o) | (1u << 10) | (3u << 8) | (1u << 6) | 1u);
+}
+
+static uint64_t pt_alloc(struct a6_gpu *g)
+{
+	const uint32_t arena = (uint32_t)((A6_OFF_SQE - A6_OFF_PT_ARENA) / 0x1000);
+	uint64_t pa = g->pt_next < arena ? a6_pool_pa(g, A6_OFF_PT_ARENA + 0x1000ull * g->pt_next) :
+	    a6_pt_extra(g->pt_next - arena);
+	if (!pa)
+		return 0;
+	g->pt_next++;
+	zero_pa(pa, 0x1000);
+	return pa;
+}
+
+static uint64_t pt_walk(struct a6_gpu *g, uint64_t table, unsigned idx)
+{
+	uint64_t e = 0;
+	a6_read(table + 8ull * idx, &e, 8);
+	if (e & 1)
+		return (e & 3) == 3 ? e & 0xfffffff000ull : 0;	/* 0: a block */
+	uint64_t t = pt_alloc(g);
+	if (t)
+		wr64(table + 8ull * idx, t | 3);
+	return t;
+}
+
+static int map_4k(struct a6_gpu *g, uint64_t iova, uint32_t n4k, uint64_t (*pa_of)(const void *, uint32_t),
+		  const void *arg)
+{
+	static uint64_t pte[512];
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1);
+	for (uint32_t i = 0; i < n4k;) {
+		uint64_t va = iova + 0x1000ull * i;
+		uint64_t l2 = pt_walk(g, l1, (va >> 30) & 0x1ff);
+		uint64_t l3 = l2 ? pt_walk(g, l2, (va >> 21) & 0x1ff) : 0;
+		if (!l3) {
+			a6_log("map: no page table for %llx (arena full, or a block there)\n", (unsigned long long)va);
+			return -1;
+		}
+		unsigned first = (va >> 12) & 0x1ff, k = 0;
+		while (first + k < 512 && i < n4k)
+			pte[k++] = pa_of(arg, i++) | (1u << 10) | (3u << 8) | (1u << 6) | 3u;
+		a6_write(l3 + 8ull * first, pte, 8ull * k);
+	}
+	return 0;
+}
+
+static uint64_t linear_pa(const void *arg, uint32_t i)
+{
+	return *(const uint64_t *)arg + 0x1000ull * i;
+}
+
+int a6_map(struct a6_gpu *g, uint64_t iova, uint64_t pa, uint64_t size)
+{
+	return map_4k(g, iova, (uint32_t)((size + 0xfff) >> 12), linear_pa, &pa);
+}
+
+struct page_list {
+	const uint64_t *pages;
+	uint32_t shift;		/* log2(page_size / 4K) */
+};
+
+static uint64_t list_pa(const void *arg, uint32_t i)
+{
+	const struct page_list *l = arg;
+	return l->pages[i >> l->shift] + 0x1000ull * (i & ((1u << l->shift) - 1));
+}
+
+int a6_map_pages(struct a6_gpu *g, uint64_t iova, const uint64_t *pages, uint32_t npages, uint32_t page_size)
+{
+	struct page_list l = { pages, 0 };
+	while ((0x1000u << l.shift) < page_size)
+		l.shift++;
+	return map_4k(g, iova, npages << l.shift, list_pa, &l);
+}
+
+void a6_unmap(struct a6_gpu *g, uint64_t iova, uint64_t size)
+{
+	static const uint64_t zeros[512];
+	uint64_t l1 = a6_pool_pa(g, A6_OFF_GT_L1);
+	uint64_t end = iova + ((size + 0xfff) & ~0xfffull);
+	for (uint64_t va = iova & ~0xfffull; va < end;) {
+		uint64_t e = 0, l2, l3;
+		a6_read(l1 + 8 * ((va >> 30) & 0x1ff), &e, 8);
+		l2 = (e & 3) == 3 ? e & 0xfffffff000ull : 0;
+		e = 0;
+		if (l2)
+			a6_read(l2 + 8 * ((va >> 21) & 0x1ff), &e, 8);
+		l3 = (e & 3) == 3 ? e & 0xfffffff000ull : 0;
+		uint64_t next = (va | 0x1fffffull) + 1;
+		if (next > end)
+			next = end;
+		if (l3)
+			a6_write(l3 + 8 * ((va >> 12) & 0x1ff), zeros, (size_t)((next - va) >> 12) * 8);
+		va = next;
+	}
+}
+
+void a6_unmap_high(struct a6_gpu *g)
+{
+	static const uint64_t zeros[511];
+	a6_write(a6_pool_pa(g, A6_OFF_GT_L1) + 8, zeros, sizeof(zeros));
+	g->pt_next = 0;
+	a6_tlb_flush(g);
+}
+
+/* ---- CP ---- */
+
+static int gpu_cp_init(struct a6_gpu *g, bool resume)
+{
+	uint32_t l4, lf;
+	const uint8_t *pm4 = a6_firmware("a530_pm4.fw", &l4), *pfp = a6_firmware("a530_pfp.fw", &lf);
+	if (!pm4 || !pfp || l4 < 8 || lf < 8 || l4 > 0x8000 || lf > 0x8000)
+		return -1;
+	a6_write(a6_pool_pa(g, OFF_PM4), pm4 + 4, (l4 - 4 + 3) & ~3u);	/* minus the first dword */
+	a6_write(a6_pool_pa(g, OFF_PFP), pfp + 4, (lf - 4 + 3) & ~3u);
+	const uint64_t pm4_va = a6_pool_va(OFF_PM4), pfp_va = a6_pool_va(OFF_PFP), rb = a6_pool_va(A6_OFF_RING);
+	const uint32_t init[][2] = {
+		{ 0x860, 1 },				/* CP_ADDR_MODE_CNTL: 64 bit */
+		/* and every block that fetches or writes memory, as kgsl's a5xx_start(); without them the RB
+		 * writes a render target at the low 32 bits of its address */
+		{ 0xbc1, 1 },				/* VSC_ADDR_MODE_CNTL */
+		{ 0xc81, 1 },				/* GRAS_ADDR_MODE_CNTL */
+		{ 0xcc5, 1 },				/* RB_ADDR_MODE_CNTL */
+		{ 0xd01, 1 },				/* PC_ADDR_MODE_CNTL */
+		{ 0xe05, 1 },				/* HLSQ_ADDR_MODE_CNTL */
+		{ 0xe41, 1 },				/* VFD_ADDR_MODE_CNTL */
+		{ 0xe61, 1 },				/* VPC_ADDR_MODE_CNTL */
+		{ 0xe80, 1 },				/* UCHE_ADDR_MODE_CNTL */
+		{ 0xec1, 1 },				/* SP_ADDR_MODE_CNTL */
+		{ 0xf01, 1 },				/* TPL1_ADDR_MODE_CNTL */
+		{ CP_PM4_BASE, (uint32_t)pm4_va }, { CP_PM4_BASE + 1, (uint32_t)(pm4_va >> 32) },
+		{ CP_PFP_BASE, (uint32_t)pfp_va }, { CP_PFP_BASE + 1, (uint32_t)(pfp_va >> 32) },
+		{ CP_RB_BASE, (uint32_t)rb }, { CP_RB_BASE + 1, (uint32_t)(rb >> 32) },
+		{ CP_RB_CNTL, 12 | 2u << 8 | 1u << 27 },	/* 32 KB, 32-byte blocks, no rptr update */
+		{ CP_RB_WPTR, 0 },
+		{ 0xf810, 1 },				/* SECVID_TSB_ADDR_MODE_CNTL: 64 bit */
+		{ 0xf800, 0 }, { 0xf801, 0 }, { 0xf802, 0 },	/* no trusted TSB range */
+		/* kgsl a5xx_start() for the a512 */
+		{ 0x3049, 0x3 },			/* VBIF_ROUND_ROBIN_QOS_ARB */
+		{ 0x302a, 0x9 },			/* VBIF_GATE_OFF_WRREQ_EN */
+		{ 0x93, 0x1 }, { 0x94, 0xa6ffffff }, { 0x95, 0x3f },	/* RBBM_AHB_CNTL0/1/2 */
+		{ 0xe96, 0x2 },				/* UCHE_CACHE_WAYS */
+		{ 0xe89, 0xffff0000 }, { 0xe8a, 0x0001ffff },	/* UCHE_TRAP_BASE */
+		{ 0xe87, 0xffff0000 }, { 0xe88, 0x0001ffff },	/* UCHE_WRITE_THRU_BASE */
+		{ 0xe8b, 0x100000 }, { 0xe8c, 0 },	/* UCHE_GMEM_RANGE: 272 KB GMEM */
+		{ 0xe8d, 0x100000 + 0x44000 - 1 }, { 0xe8e, 0 },
+		{ 0xe81, 1u << 29 },			/* UCHE_MODE_CNTL */
+		{ 0x825, 0x40 }, { 0x826, 0x400 },	/* CP_MEQ_THRESHOLDS, CP_MERCIU_SIZE */
+		{ 0x820, 0x80000060 }, { 0x81f, 0x40201b16 },	/* CP_ROQ_THRESHOLDS_2, _1 */
+		{ 0x833, 0x02000000 },			/* CP_CHICKEN_DBG */
+		{ 0x67, 0 },				/* RBBM_CLOCK_CNTL: hw clock gating off */
+	};
+	for (unsigned i = 0; i < sizeof(init) / sizeof(init[0]); i++)
+		wr32(GREG(init[i][0]), init[i][1]);
+	g->wptr = 0;
+	wr32(GREG(CP_ME_CNTL), 0);		/* run ME and PFP */
+
+	uint32_t me_init[] = { a6_pkt7(A6_CP_ME_INIT, 8), 0x2f, 3, 0x20000000, 0, 0, 0, 0, 0 };
+	if (a6_ring(g, me_init, 9, "me_init", 1000))
+		return -1;
+	if (resume ? zap_resume() : zap_load(g))
+		return -1;
+	uint32_t secure[] = { a6_pkt7(A6_CP_SET_SECURE_MODE, 1), 0 };
+	int rc = a6_ring(g, secure, 2, "secure mode off", 1000);
+	a6_log("cp: trust cntl %x\n", rd32(GREG(SECVID_TRUST)));
+	return rc;
+}
+
+/* After a hang or fault: soft reset, then the CP up again (page tables and SMMU banks kept) */
+int a6_recover(struct a6_gpu *g)
+{
+	(void)a6_clear_fault(g);
+	wr32(GREG(0x43), 1);			/* RBBM_SW_RESET_CMD */
+	(void)rd32(GREG(0x43));
+	a6_delay_us(100);
+	wr32(GREG(0x43), 0);
+	a6_delay_ms(1);
+	(void)a6_clear_fault(g);
+	int rc = gpu_cp_init(g, true);
+	a6_log("recover: soft reset + CP init -> %d\n", rc);
+	return rc;
+}
+
+int a6_power_up(struct a6_gpu *g)
+{
+	/* the SMMU with only CX up, as Linux's probe; GX after */
+	if (power_cx() || smmu_reset())
+		return -1;
+	map_gpu_low(g);
+	if (smmu_banks(a6_pool_pa(g, A6_OFF_GT_L1)) || power_gx())
+		return -1;
+	gfx_clock(g->perf_level);
+	log_cpu_clocks();
+	log_bus_clocks();
+	if (a9y_rpm_bus_max())		/* bsd/dev/a9y_rpm.c: the RPM's clocks (DDR among them) at their maximum */
+		log_bus_clocks();
+	gold_clock(g->gold_mhz);
+	if (gpu_cp_init(g, false))
+		return -1;
+	/* self test: an IB (scratch + 0x200) whose CP_MEM_WRITE lands at scratch + 0x100 */
+	uint64_t ib = a6_pool_va(A6_OFF_SCRATCH + 0x200), dst = a6_pool_va(A6_OFF_SCRATCH + 0x100);
+	uint32_t zero = 0, got = 0, cmd[] = {
+		a6_pkt7(A6_CP_MEM_WRITE, 3), (uint32_t)dst, (uint32_t)(dst >> 32), 0xa9c0ffee,
+	};
+	a6_write(a6_pool_pa(g, A6_OFF_SCRATCH + 0x100), &zero, 4);
+	a6_write(a6_pool_pa(g, A6_OFF_SCRATCH + 0x200), cmd, sizeof(cmd));
+	int rc = a6_submit_ib(g, ib, sizeof(cmd) / 4, 100);
+	a6_read(a6_pool_pa(g, A6_OFF_SCRATCH + 0x100), &got, 4);
+	a6_log("self test: IB submit %d, fence %u, wrote %x: %s\n", rc, a6_fence_read(g), got,
+	       !rc && got == 0xa9c0ffee ? "the GPU runs IBs through its page tables" : "FAILED");
+	return rc || got != 0xa9c0ffee ? -1 : 0;
+}
+
+/* ---- 2D blit: none yet on the a512 (see the top) ---- */
+
+uint32_t a6_blit_ib(const struct a6_gpu *g, const struct a6_blit *b, uint32_t *dw)
+{
+	(void)g;
+	(void)b;
+	(void)dw;
+	return 0;
+}
+
+/* ---- present: the captured draw (sweet_a6xx.h a5_fit_ib) ---- */
+
+#include "sweet_a5xx_fit.h"
+
+_Static_assert(A5FIT_BYTES <= A5_FIT_BYTES_MAX, "present template outgrew its pool slot");
+
+static void fit_reloc(struct a6_gpu *g, uint64_t off, unsigned kind, uint64_t base)
+{
+	for (unsigned i = 0; i < sizeof(a5fit_relocs) / sizeof(a5fit_relocs[0]); i++) {
+		const struct a5fit_reloc *r = &a5fit_relocs[i];
+		uint64_t v = base + r->add;
+		uint32_t lo = (uint32_t)v, hi = 0;
+		if (r->kind != kind)
+			continue;
+		/* the high half's upper bits are fields (TEX_CONST DEPTH): keep them */
+		a6_read(a6_pool_pa(g, off) + 4ull * r->hi, &hi, 4);
+		hi = (hi & ~0xffu) | (uint32_t)(v >> 32);
+		a6_write(a6_pool_pa(g, off) + 4ull * r->lo, &lo, 4);
+		a6_write(a6_pool_pa(g, off) + 4ull * r->hi, &hi, 4);
+	}
+}
+
+uint32_t a5_fit_ib(struct a6_gpu *g, uint64_t off, bool build, uint64_t src_iova, uint64_t dst_iova,
+		   uint64_t *ib_iova)
+{
+	if (build) {
+		zero_pa(a6_pool_pa(g, off), A5FIT_BYTES);
+		for (unsigned i = 0; i < sizeof(a5fit_runs) / sizeof(a5fit_runs[0]); i++)
+			a6_write(a6_pool_pa(g, off) + 4ull * a5fit_runs[i].dword, &a5fit_data[a5fit_runs[i].data],
+				 4ull * a5fit_runs[i].count);
+		fit_reloc(g, off, A5FIT_SELF, a6_pool_va(off));
+	}
+	fit_reloc(g, off, A5FIT_DST, dst_iova);   /* every time: the present flips between panel buffers */
+	fit_reloc(g, off, A5FIT_SRC, src_iova);
+	*ib_iova = a6_pool_va(off + A5FIT_IB_OFF);
+	return A5FIT_IB_DWORDS;
+}
