+#if defined(ARM64_BOARD_CONFIG_A9Y18QLTE)
+#define GICR_ISPENDR0                           0x10200
+#define GICR_ISACTIVER0                         0x10300
+#define GICD_TYPER                              0x4
+#define GICD_ISENABLER(n)                       (0x100 + 4 * (n))
+#define GICD_ISPENDR(n)                         (0x200 + 4 * (n))
+
+uint64_t sweet_irq_counts[4];
+uint32_t sweet_irq_last_other;
+void sweet_gic_dump(const char *when);
+
+/*
+ * a9y18qlte bring-up: this CPU's timer and GIC state, read without taking
+ * an interrupt, for when IRQs never arrive on the phone.
+ */
+void
+sweet_gic_dump(const char *when)
+{
+	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+
+	kprintf("SWEET GIC %s: DAIF=0x%llx CNTV_CTL=0x%llx CNTV_CVAL=0x%llx CNTVCT=0x%llx CNTP_CTL=0x%llx\n",
+	    when, __builtin_arm_rsr64("DAIF"), __builtin_arm_rsr64("CNTV_CTL_EL0"),
+	    __builtin_arm_rsr64("CNTV_CVAL_EL0"), __builtin_arm_rsr64("CNTVCT_EL0"),
+	    __builtin_arm_rsr64("CNTP_CTL_EL0"));
+	kprintf("SWEET GIC %s: HPPIR1=%llu RPR=0x%llx PMR=0x%llx IGRPEN1=%llu CTLR=0x%llx GICD_CTLR=0x%x\n",
+	    when, __builtin_arm_rsr64("ICC_HPPIR1_EL1"), __builtin_arm_rsr64("ICC_RPR_EL1"),
+	    __builtin_arm_rsr64("ICC_PMR_EL1"), __builtin_arm_rsr64("ICC_IGRPEN1_EL1"),
+	    __builtin_arm_rsr64("ICC_CTLR_EL1"), gicd_read32(GICD_CTLR));
+	kprintf("SWEET GIC %s: GICR en=0x%x pend=0x%x act=0x%x grp=0x%x waker=0x%x\n",
+	    when, gicr_read32(GICR_ISENABLER0), gicr_read32(GICR_ISPENDR0),
+	    gicr_read32(GICR_ISACTIVER0), gicr_read32(GICR_IGROUPR0), gicr_read32(GICR_WAKER));
+	if (!(gicr_read32(GICR_ISENABLER0) & (1U << sweet_vtimer_intid))) {
+		gicr_write32(GICR_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+		__builtin_arm_dsb(DSB_SY);
+		kprintf("SWEET GIC %s: timer not enabled, wrote ISENABLER0 again: en=0x%x\n",
+		    when, gicr_read32(GICR_ISENABLER0));
+	}
+	kprintf("SWEET GIC %s: IRQs timer=%llu ipi=%llu other=%llu (last %u) spurious=%llu\n",
+	    when, sweet_irq_counts[0], sweet_irq_counts[1], sweet_irq_counts[2],
+	    sweet_irq_last_other, sweet_irq_counts[3]);
+	unsigned int lines = 32 * ((gicd_read32(GICD_TYPER) & 0x1f) + 1);
+	for (unsigned int n = 1; n < lines / 32; n++) {
+		uint32_t en = gicd_read32(GICD_ISENABLER(n)), pend = gicd_read32(GICD_ISPENDR(n));
+		if (en || pend) {
+			kprintf("SWEET GIC %s: SPI %u-%u en=0x%x pend=0x%x\n",
+			    when, 32 * n, 32 * n + 31, en, pend);
+		}
+	}
+}
