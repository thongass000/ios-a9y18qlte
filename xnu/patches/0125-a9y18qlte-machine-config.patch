 #include <pexpert/arm64/SWEET.h>
 
 #define MAX_L2_CLINE                   6
@@ -108,6 +108,17 @@
 
 #endif  /* ARM64_BOARD_CONFIG_SWEET */
 
+#ifdef ARM64_BOARD_CONFIG_A9Y18QLTE
