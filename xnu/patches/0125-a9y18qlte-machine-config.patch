+#ifndef A9Y18QLTE		/* ARMv8.0, 4K granule only: see A9Y18QLTE.h */
 #define __ARM_PAN_AVAILABLE__     1
 #define __ARM_16K_PG__            1
+#endif
 
 #define HAS_GIC_V3                1
 
