index 145bb8b..45d4ddc 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -694,8 +694,42 @@ Lkernelcache_base_found:
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+#if defined(__ARM_16K_PG__)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#else
+	/*
+	 * 4K pages (A9Y18QLTE): an L1 entry covers only 1GB, and the a9y18qlte
+	 * RAM (0x100000000 up) is not in the framebuffer's. Use the L2 table of
+	 * the framebuffer's L1 entry if the RAM mapping made one, else take the
+	 * next bootstrap page (x2 is the last one allocated) for it. An L2
+	 * block is 2MB, so the same 32MB as sixteen blocks.
+	 */
+	and		x13, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x13, x13, #(ARM_TT_L1_SHIFT)
+	ldr		x13, [x25, x13, lsl #TTE_SHIFT]
+	tbz		x13, #0, Lsweet_fb_new_l2
+	and		x13, x13, #(ARM_TTE_TABLE_MASK)
+	b		Lsweet_fb_l2
+Lsweet_fb_new_l2:
+	add		x2, x2, PGBYTES
+	mov		x13, x2
+	mov		x9, #(PGBYTES / 8)
+Lsweet_fb_zero:
+	str		xzr, [x13], #8
+	subs	x9, x9, #1
+	b.ne	Lsweet_fb_zero
+	create_l1_table_entry	x10, x25, x2, x9, x13, x14
+	mov		x13, x2
+Lsweet_fb_l2:
+	mov		x10, #16
+Lsweet_fb_block:
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	add		x11, x11, #(1 << ARM_TT_L2_SHIFT)
+	add		x12, x12, #1
+	subs	x10, x10, #1
+	b.ne	Lsweet_fb_block
+#endif
 #endif
 
