diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..04c315c 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,19 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(__ARM_FEATURE_ATOMICS)
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#else
+	// ARMv8.0 (a9y): the same CAS with an exclusive pair
+Ltrylock_enqueue_cas:
+	ldaxr	w10, [x3]
+	cbnz	w10, Ltrylock_enqueue_busy
+	stxr	w12, w11, [x3]
+	cbnz	w12, Ltrylock_enqueue_cas
+	b		Ltrylock_enqueue_success
+Ltrylock_enqueue_busy:
+	clrex
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +335,19 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(__ARM_FEATURE_ATOMICS)
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#else
+	// ARMv8.0 (a9y): the same CAS with an exclusive pair
+Ltrylock_dequeue_cas:
+	ldaxr	w10, [x2]
+	cbnz	w10, Ltrylock_dequeue_busy
+	stxr	w12, w11, [x2]
+	cbnz	w12, Ltrylock_dequeue_cas
+	b		Ltrylock_dequeue_success
+Ltrylock_dequeue_busy:
+	clrex
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index bd099f8..4734785 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -10981,6 +10981,16 @@ static_assert((_COMM_PAGE32_BASE_ADDRESS & ~ARM_TT_L2_OFFMASK) >= VM_MAX_ADDRESS
  * a reserved region (see vm_reserved_regions[] definition for more info).
  */
 
+#elif (ARM_PGSHIFT == 12) && defined(SWEET)
+/**
+ * SWEET builds with SDKROOT=macosx, so the user VA range is macOS's and the
+ * commpage lives inside it, as with 16K pages above. The VM reserves the
+ * commpage nesting region in every 64-bit map (vm_reserved_regions[]); with
+ * 4K pages that region must be exactly the L1 block holding the commpage.
+ */
+static_assert((_COMM_PAGE64_NESTING_START & ARM_TT_L1_OFFMASK) == 0);
+static_assert(_COMM_PAGE64_NESTING_SIZE == ARM_TT_L1_SIZE);
+static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) == _COMM_PAGE64_NESTING_START);
 #elif (ARM_PGSHIFT == 12)
 /**
  * Ensure that 64-bit devices using 4K pages can nest the commpage completely
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index 963e02d..dd3ef8d 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -33,8 +33,15 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#ifndef SWEET_A9Y
 #define __ARM_PAN_AVAILABLE__     1
 #define __ARM_16K_PG__            1
+#else
+/*
+ * Galaxy A9 2018 (SDM660): Kryo 260 is ARMv8.0. PAN is ARMv8.1, and
+ * ID_AA64MMFR0.TGran16 is 0, so 4K pages as on BCM2837.
+ */
+#endif
 
 #define HAS_GIC_V3                1
 
