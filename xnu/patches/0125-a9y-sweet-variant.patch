diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index c6e2d70..83191bb 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -65,6 +65,11 @@ MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 # and -march=armv8.2-a+crypto kept its features, so clang vectorized XORs into EOR3 (FEAT_SHA3),
 # an undefined instruction on the A76/A55 (panic in a6_blit_ib). Cortex-A55 = the ISA both clusters share.
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a55+crypto
+# SWEET_VARIANT=a9y: Galaxy A9 2018 (SDM660, Kryo 260 = Cortex-A73 + Cortex-A53), ARMv8.0:
+# no LSE, no PAN, no 16K granule (ID_AA64MMFR0 0x1122). Same board code, 4K pages.
+ifeq ($(SWEET_VARIANT),a9y)
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET -DSWEET_A9Y    -mcpu=cortex-a53+crc+crypto
+endif
 
 
