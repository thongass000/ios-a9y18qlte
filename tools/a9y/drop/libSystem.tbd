                   _read, _pipe, _chdir, _kill, _waitpid, _environ, _posix_spawn, _posix_spawnattr_init,
                   _posix_spawnattr_setflags, _posix_spawnattr_destroy, _posix_spawn_file_actions_init,
                   _posix_spawn_file_actions_adddup2, _posix_spawn_file_actions_addclose,
                   _posix_spawn_file_actions_destroy, _memcpy, _memset, dyld_stub_binder ]
...
