+/* a9y18qlte: the dimming scenes' colours: the grey half and each bar, inside the dimmed band and above it */
+static void
+dim_report(int n, const uint8_t *out, const uint8_t *ref)
+{
+   static const char *name[5] = { "grey", "red", "green", "blue", "white" };
+   static const int x0[5] = { 32, 136, 168, 200, 232 }, x1[5] = { 96, 152, 184, 216, 248 };
+   for (int k = 0; k < 5; k++) {
+      double in[3] = { 0, 0, 0 }, top[3] = { 0, 0, 0 };
+      int cnt = 0;
+      for (int y = 0; y < 32; y++) for (int x = x0[k]; x < x1[k]; x++, cnt++) for (int c = 0; c < 3; c++) {
+         in[c] += out[((112 + y) * W + x) * 4 + c];
+         top[c] += out[((16 + y) * W + x) * 4 + c];
+      }
+      const uint8_t *r = ref + (128 * W + (x0[k] + x1[k]) / 2) * 4;
+      printf("dim %d %-5s RGB dimmed %3.0f %3.0f %3.0f undimmed %3.0f %3.0f %3.0f (CPU %d %d %d)\n", n, name[k], in[2] / cnt,
+             in[1] / cnt, in[0] / cnt, top[2] / cnt, top[1] / cnt, top[0] / cnt, r[2], r[1], r[0]);
+   }
+}
