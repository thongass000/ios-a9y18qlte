a9y18qlte: Chlorophyll: no 16-bit arithmetic before a6xx

backboardd's frames on Chlorophyll stayed empty on the A512: every full-screen frame ends in
CoreAnimation's luma_boost_lph pass, and frames with it were all (0,0,0,0) (214 of 214) while frames
without it had content. QuartzCore's sweep shows the pattern across the library: the half-precision
variants (*_lph) come out wrong or empty where the float ones (*_lpf) are right (luma_boost,
narrow_blur_15/19/27, ...). Mesa never makes 16-bit code for a5xx (ir3 lowers mediump only for
gen >= 6). Before a6xx, texture results become 32-bit and nir_lower_bit_size runs every 16-bit ALU
instruction at 32 bits; memory access and conversions stay 16-bit. RWA_16BIT_ALU=1 keeps them.

Assisted-by: LLM

diff --git a/air/air_metal.c b/air/air_metal.c
index 07c4dfc..50571b7 100644
--- a/air/air_metal.c
+++ b/air/air_metal.c
@@ -5711,6 +5711,58 @@ widen_fs_outputs(nir_shader *nir)
    }
 }
 
+/* a9y18qlte: no 16-bit arithmetic before a6xx. CoreAnimation's half-precision variants (*_lph) came out wrong on the
+ * Adreno 512 where the float ones (*_lpf) were right -- luma_boost_lph drew all zeros, and as backboardd's last pass
+ * over every frame it left the screen black; narrow_blur_15/19/27_lph likewise -- and Mesa never makes 16-bit code for
+ * a5xx (ir3 lowers mediump only for gen >= 6), so none of it is exercised there. Texture results arrive 32-bit and
+ * every 16-bit ALU instruction runs at 32 bits (nir_lower_bit_size converts at its edges); what stays 16-bit is
+ * memory access and the conversions themselves, which the widened varyings and outputs already use. */
+static unsigned
+lower_16bit_alu(const nir_instr *instr, void *data)
+{
+   (void)data;
+   if (instr->type != nir_instr_type_alu)
+      return 0;
+   const nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (nir_op_infos[alu->op].is_conversion)
+      return 0;
+   if (alu->def.bit_size == 16)
+      return 32;
+   for (unsigned i = 0; i < nir_op_infos[alu->op].num_inputs; i++)
+      if (nir_src_bit_size(alu->src[i].src) == 16)
+         return 32;
+   return 0;
+}
+
+static void
+no_16bit_alu(nir_shader *nir)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_builder b = nir_builder_create(impl);
+      bool progress = false;
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *tex = nir_instr_as_tex(instr);
+            if (tex->def.bit_size != 16)
+               continue;
+            nir_alu_type base = nir_alu_type_get_base_type(tex->dest_type);
+            tex->def.bit_size = 32;
+            tex->dest_type = (nir_alu_type)(base | 32);
+            b.cursor = nir_after_instr(instr);
+            nir_def *narrow = base == nir_type_float ? nir_f2f16(&b, &tex->def) : base == nir_type_int
+                                                                                     ? nir_i2i16(&b, &tex->def)
+                                                                                     : nir_u2u16(&b, &tex->def);
+            nir_def_rewrite_uses_after(&tex->def, narrow, narrow->parent_instr);
+            progress = true;
+         }
+      }
+      nir_metadata_preserve(impl, progress ? nir_metadata_control_flow : nir_metadata_all);
+   }
+   NIR_PASS(_, nir, nir_lower_bit_size, lower_16bit_alu, NULL);
+}
+
 static void *
 make_stage_cso(struct rwa_device *device, nir_shader *nir, char *why, size_t why_size)
 {
@@ -5722,6 +5774,8 @@ make_stage_cso(struct rwa_device *device, nir_shader *nir, char *why, size_t why
    finalize_for_gallium(clone, device->screen);
    if (clone->info.stage == MESA_SHADER_FRAGMENT && pre_a6xx(device))
       widen_fs_outputs(clone);
+   if (pre_a6xx(device) && !(getenv("RWA_16BIT_ALU") && getenv("RWA_16BIT_ALU")[0] == '1'))
+      no_16bit_alu(clone);
 
    struct pipe_shader_state templ = { .type = PIPE_SHADER_IR_NIR, .ir.nir = clone };
    struct pipe_context *pipe = device->pipe;
