@@ -6535,12 +6535,27 @@ size_unsized_constants(nir_shader *nir, struct air_shader_info *info)
  * cb_delta_mask): every load from one becomes load(offset + delta[index]), the deltas living in the last of the 16 constant
  * buffer slots a6xx has, when the shader leaves it free. RWA_CB_DELTA=0 turns it off. */
 #define CB_DELTA_SLOT 15
+/* a9y18qlte: not before a6xx. There ir3 reads a constant buffer through a table of pointers in the constant file (ldg,
+ * ir3_emit_ubos), not ldc, and with the deltas in slot 15 the Adreno 512 drew the probes' interpolated triangle black
+ * and left RGBA32Float targets untouched (bgmtl_render_probe P4, P7, P8); without them all pass, so there the copying
+ * path stays. RWA_CB_DELTA=1 or 0 forces it either way. */
+static bool
+cb_deltas_fit(struct rwa_device *device)
+{
+   const char *env = getenv("RWA_CB_DELTA");
+   if (env && (env[0] == '0' || env[0] == '1'))
+      return env[0] == '1';
+   const char *name = device->screen->get_name(device->screen);
+   unsigned chip;
+   return !(name && sscanf(name, "FD%u", &chip) == 1 && chip < 600);
+}
