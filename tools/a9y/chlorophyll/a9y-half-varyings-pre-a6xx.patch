+/* a9y18qlte: 16-bit varyings become 32-bit before a6xx. CoreAnimation's low-precision shaders (fixed_vert_lph_* into
+ * fixed_frag_lph_*) pass their varyings as `half`; Apple's GPUs interpolate them at full precision, ir3 on the A512 in
+ * fp16, and the edge coverage of a rounded layer, interpolated along CoreAnimation's long thin triangles, came out
+ * wrong per triangle: dashed lines along every rounded edge (CARenderer probe scenes 3, 7, 9: the interior draw wrote
+ * half coverage in blocks; square layers were exact). After nir_lower_io: the vertex stage's 16-bit varying stores are
+ * widened, the fragment stage's 16-bit input loads are made 32-bit and narrowed after; so are the variables. */
+static void
+widen_half_varyings(nir_shader *nir)
+{
+   bool vs = nir->info.stage == MESA_SHADER_VERTEX;
+   nir_foreach_function_impl(impl, nir) {
+      nir_builder b = nir_builder_create(impl);
+      bool progress = false;
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            if (vs && in->intrinsic == nir_intrinsic_store_output && in->src[0].ssa->bit_size == 16) {
+               nir_io_semantics sem = nir_intrinsic_io_semantics(in);
+               if (sem.location == VARYING_SLOT_POS || sem.location == VARYING_SLOT_PSIZ)
+                  continue;
+               nir_alu_type base = nir_alu_type_get_base_type(nir_intrinsic_src_type(in));
+               b.cursor = nir_before_instr(instr);
+               nir_def *v = in->src[0].ssa;
+               nir_def *w = base == nir_type_float ? nir_f2f32(&b, v) : base == nir_type_int ? nir_i2i32(&b, v)
+                                                                                            : nir_u2u32(&b, v);
+               nir_src_rewrite(&in->src[0], w);
+               nir_intrinsic_set_src_type(in, (nir_alu_type)(base | 32));
+               sem.medium_precision = 0;
+               nir_intrinsic_set_io_semantics(in, sem);
+               progress = true;
+            } else if (!vs && (in->intrinsic == nir_intrinsic_load_interpolated_input ||
+                               in->intrinsic == nir_intrinsic_load_input) && in->def.bit_size == 16) {
+               nir_alu_type base = nir_alu_type_get_base_type(nir_intrinsic_dest_type(in));
+               nir_intrinsic_instr *w = nir_instr_as_intrinsic(nir_instr_clone(b.shader, instr));
+               w->def.bit_size = 32;
+               nir_intrinsic_set_dest_type(w, (nir_alu_type)(base | 32));
+               nir_io_semantics sem = nir_intrinsic_io_semantics(w);
+               sem.medium_precision = 0;
+               nir_intrinsic_set_io_semantics(w, sem);
+               b.cursor = nir_before_instr(instr);
+               nir_builder_instr_insert(&b, &w->instr);
+               nir_def *v = base == nir_type_float ? nir_f2f16(&b, &w->def) : base == nir_type_int ? nir_i2i16(&b, &w->def)
+                                                                                                  : nir_u2u16(&b, &w->def);
+               nir_def_rewrite_uses(&in->def, v);
+               nir_instr_remove(instr);
+               progress = true;
+            }
+         }
+      }
+      nir_metadata_preserve(impl, progress ? nir_metadata_control_flow : nir_metadata_all);
+   }
+   nir_foreach_variable_with_modes(var, nir, vs ? nir_var_shader_out : nir_var_shader_in) {
+      if ((vs && (var->data.location == VARYING_SLOT_POS || var->data.location == VARYING_SLOT_PSIZ)) ||
+          !glsl_type_is_vector_or_scalar(var->type))
+         continue;
+      enum glsl_base_type t = glsl_get_base_type(var->type);
+      enum glsl_base_type w = t == GLSL_TYPE_FLOAT16 ? GLSL_TYPE_FLOAT : t == GLSL_TYPE_INT16 ? GLSL_TYPE_INT
+                              : t == GLSL_TYPE_UINT16 ? GLSL_TYPE_UINT : t;
+      if (w != t)
+         var->type = glsl_vector_type(w, glsl_get_vector_elements(var->type));
+   }
+}
