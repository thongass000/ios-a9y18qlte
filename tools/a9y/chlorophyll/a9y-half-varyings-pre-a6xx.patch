@@ -5806,6 +5871,8 @@ make_stage_cso(struct rwa_device *device, nir_shader *nir, char *why, size_t why
       lower_fbfetch_pre_a6xx(clone);
       widen_fs_outputs(clone);
    }
+   if (pre_a6xx(device) && !getenv("A9Y_HALF_VARYINGS"))
