+/* a9y18qlte: BGR10_XR words <-> the BGRA8 the A512 draws. XR10 maps 0..1 to 384..894 (510 steps), so a byte b is the word
+ * value 2b + 384, blue in bits 0..9, green 10..19, red 20..29; values outside 0..1 do not survive the BGRA8 stand-in. */
+static void
+bg_xr_stats(const char *what, unsigned w, unsigned h, uint64_t t0)
+{
+   static unsigned n[2];
+   static uint64_t ns[2];
+   int k = what[0] == 's';
+   mach_timebase_info_data_t tb;
+   mach_timebase_info(&tb);
+   ns[k] += (mach_absolute_time() - t0) * tb.numer / tb.denom;
+   if (++n[k] <= 4 || n[k] % 50 == 0)
+      BG_LOG("XR10 %s #%u (%ux%u): %llu ms on average\n", what, n[k], w, h, (unsigned long long)(ns[k] / n[k] / 1000000));
+}
+
+// called with bg_lock held (rwaTextureSampledLocked)
+- (void)bgXrLoad
+{
+   uint64_t t0 = mach_absolute_time();
+   unsigned w = _shape.width, h = _shape.height;
+   uint8_t *px = malloc((size_t)w * h * 4);
+   if (!px) return;
+   IOSurfaceRef s = (IOSurfaceRef)_surface;
+   IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL);
+   const uint8_t *p0 = IOSurfaceGetBaseAddressOfPlane(s, 0), *p1 = _xrAlpha ? IOSurfaceGetBaseAddressOfPlane(s, 1) : NULL;
+   size_t r0 = IOSurfaceGetBytesPerRowOfPlane(s, 0), r1 = _xrAlpha ? IOSurfaceGetBytesPerRowOfPlane(s, 1) : 0;
+   for (unsigned y = 0; y < h; y++) {
+      const uint32_t *src = (const uint32_t *)(p0 + y * r0);
+      uint8_t *d = px + (size_t)y * w * 4;
+      for (unsigned x = 0; x < w; x++, d += 4) {
+         uint32_t v = src[x];
+         for (int c = 0; c < 3; c++) {   // B, G, R
+            int code = (int)((v >> (10 * c)) & 0x3ff) - 384;
+            d[c] = code <= 0 ? 0 : code >= 510 ? 255 : (uint8_t)((code + 1) >> 1);
+         }
+         d[3] = p1 ? p1[y * r1 + x] : 255;
+      }
+   }
+   IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+   char why[256] = { 0 };
+   const unsigned o[3] = { 0, 0, 0 }, sz[3] = { w, h, 1 };
+   if (rwa_texture_write(_tex, 0, 0, o, sz, px, (size_t)w * 4, why, sizeof(why)) != 0)
+      BG_LOG("XR10 surface load: %s\n", why);
+   free(px);
+   bg_xr_stats("load", w, h, t0);
+}
+
+- (void)bgXrStore
+{
+   if (!_xr || !_tex) return;
+   uint64_t t0 = mach_absolute_time();
+   unsigned w = _shape.width, h = _shape.height;
+   uint8_t *px = malloc((size_t)w * h * 4);
+   if (!px) return;
+   char why[256] = { 0 };
+   const unsigned o[3] = { 0, 0, 0 }, sz[3] = { w, h, 1 };
+   bg_lock();
+   int rc = rwa_texture_read(_tex, 0, 0, o, sz, px, (size_t)w * 4, why, sizeof(why));
+   bg_unlock();
+   if (rc != 0) { BG_LOG("XR10 surface store: %s\n", why); free(px); return; }
+   IOSurfaceRef s = (IOSurfaceRef)_surface;
+   IOSurfaceLock(s, 0, NULL);
+   uint8_t *p0 = IOSurfaceGetBaseAddressOfPlane(s, 0), *p1 = _xrAlpha ? IOSurfaceGetBaseAddressOfPlane(s, 1) : NULL;
+   size_t r0 = IOSurfaceGetBytesPerRowOfPlane(s, 0), r1 = _xrAlpha ? IOSurfaceGetBytesPerRowOfPlane(s, 1) : 0;
+   for (unsigned y = 0; y < h; y++) {
+      uint32_t *dst = (uint32_t *)(p0 + y * r0);
+      const uint8_t *b = px + (size_t)y * w * 4;
+      for (unsigned x = 0; x < w; x++, b += 4)
+         dst[x] = (2u * b[0] + 384) | (2u * b[1] + 384) << 10 | (2u * b[2] + 384) << 20;
+      if (p1)
+         for (unsigned x = 0; x < w; x++) p1[y * r1 + x] = px[((size_t)y * w + x) * 4 + 3];
+   }
+   static int told;
+   if (told++ < 8) {
+      const uint8_t *c = px + ((size_t)(h / 2) * w + w / 2) * 4;
+      BG_LOG("XR10 surface %u stored: centre BGRA %u %u %u %u -> word %08x\n", IOSurfaceGetID(s), c[0], c[1], c[2], c[3],
+             ((const uint32_t *)(p0 + (h / 2) * r0))[w / 2]);
+   }
+   IOSurfaceUnlock(s, 0, NULL);   // moves the seed: readers see a new picture
+   free(px);
+   bg_lock();
+   _xrLoaded = YES;               // the texture already holds what the surface now does
+   _xrSeed = IOSurfaceGetSeed(s);
+   bg_unlock();
+   bg_xr_stats("store", w, h, t0);
+}
