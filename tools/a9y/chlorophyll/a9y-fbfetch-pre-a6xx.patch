+/* a9y18qlte: framebuffer fetch before a6xx. freedreno advertises fbfetch only on a6xx: ir3 turns a fetch into a read
+ * of a texture slot that only fd6 fills with the render target (patch_fb_read_sysmem), so on the A512 every
+ * [[color(n)]] read was zero -- and CoreAnimation's luma_boost, a full-screen pass that rewrites the frame from what
+ * it fetches, left every frame of backboardd's (0,0,0,0). Here each fetch (load_output with fb_fetch_output, after
+ * nir_lower_io) becomes a texelFetch of colour attachment n at the fragment's own pixel, from A9Y_FETCH_SLOT(n),
+ * where rwa_render_draw binds that attachment; the draw is in sysmem behind a texture barrier already. */
+static void
+lower_fbfetch_pre_a6xx(nir_shader *nir)
+{
+   if (!nir->info.fs.uses_fbfetch_output)
+      return;
+   nir_foreach_function_impl(impl, nir) {
+      nir_builder b = nir_builder_create(impl);
+      bool progress = false;
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+            if (in->intrinsic != nir_intrinsic_load_output)
+               continue;
+            nir_io_semantics sem = nir_intrinsic_io_semantics(in);
+            if (!sem.fb_fetch_output || sem.location < FRAG_RESULT_DATA0 || sem.location >= FRAG_RESULT_DATA0 + 8)
+               continue;
+            unsigned slot = A9Y_FETCH_SLOT(sem.location - FRAG_RESULT_DATA0);
+            nir_alu_type base = nir_alu_type_get_base_type(nir_intrinsic_dest_type(in));
+            b.cursor = nir_before_instr(instr);
+            nir_def *xy = nir_f2i32(&b, nir_channels(&b, nir_load_frag_coord(&b), 0x3));
+            nir_tex_instr *tex = nir_tex_instr_create(b.shader, 2);
+            tex->op = nir_texop_txf;
+            tex->sampler_dim = GLSL_SAMPLER_DIM_2D;
+            tex->dest_type = (nir_alu_type)(base | 32);
+            tex->coord_components = 2;
+            tex->texture_index = slot;
+            tex->sampler_index = slot;
+            tex->src[0] = nir_tex_src_for_ssa(nir_tex_src_coord, xy);
+            tex->src[1] = nir_tex_src_for_ssa(nir_tex_src_lod, nir_imm_int(&b, 0));
+            nir_def_init(&tex->instr, &tex->def, 4, 32);
+            nir_builder_instr_insert(&b, &tex->instr);
+            unsigned comp = nir_intrinsic_component(in), n = in->def.num_components;
+            nir_def *v = nir_channels(&b, &tex->def, BITFIELD_MASK(n) << comp);
+            if (in->def.bit_size == 16)
+               v = base == nir_type_float ? nir_f2f16(&b, v) : base == nir_type_int ? nir_i2i16(&b, v) : nir_u2u16(&b, v);
+            nir_def_rewrite_uses(&in->def, v);
+            nir_instr_remove(instr);
+            BITSET_SET(nir->info.textures_used, slot);
+            BITSET_SET(nir->info.textures_used_by_txf, slot);
+            nir->info.num_textures = MAX2(nir->info.num_textures, slot + 1);
+            progress = true;
+         }
+      }
+      nir_metadata_preserve(impl, progress ? nir_metadata_control_flow : nir_metadata_all);
+   }
+   BITSET_SET(nir->info.system_values_read, SYSTEM_VALUE_FRAG_COORD);
+   nir->info.fs.uses_fbfetch_output = false;
+}
