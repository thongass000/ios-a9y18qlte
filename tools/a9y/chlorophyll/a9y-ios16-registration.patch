diff --git a/src/a9y_devices.h b/src/a9y_devices.h
new file mode 100644
index 0000000..eb59ccf
--- /dev/null
+++ b/src/a9y_devices.h
@@ -0,0 +1,17 @@
+// a9y18qlte: Metal's device list without MTLCopyAllDevices, which iOS 16's Metal.framework does not export (iOS 18's
+// does). MTLAddDevice asserts `_deviceArray != NULL`; on iOS 16 MTLCreateSystemDefaultDevice's dispatch_once makes
+// that array (and the queue MTLAddDevice syncs on) before it looks for devices, and answers the array's only device
+// (nil when it is empty or holds more than one). So there: call it once before MTLAddDevice, and read it back after.
+#import <Foundation/Foundation.h>
+#include <dlfcn.h>
+
+static inline NSArray *
+a9y_mtl_devices(void)
+{
+   NSArray *(*all)(void) = (NSArray * (*)(void))dlsym(RTLD_DEFAULT, "MTLCopyAllDevices");
+   if (all)
+      return all();
+   id (*def)(void) = (id (*)(void))dlsym(RTLD_DEFAULT, "MTLCreateSystemDefaultDevice");
+   id d = def ? def() : nil;
+   return d ? @[ d ] : @[];
+}
